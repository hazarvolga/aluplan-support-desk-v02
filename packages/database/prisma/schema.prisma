generator client {
  provider        = "prisma-client-js"
  output          = "../client"
  previewFeatures = ["driverAdapters", "postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "public"), vector(schema: "public")]
}

model User {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                   String                    @unique @db.VarChar(255)
  fullName                String                    @db.VarChar(255)
  passwordHash            String
  refreshTokenHash        String?                   @map("refresh_token_hash")
  avatarUrl               String?
  status                  UserStatus                @default(ACTIVE)
  deletedAt               DateTime?                 @map("deleted_at")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  roleId                  String?                   @map("role_id") @db.Uuid
  agentStatus             AgentStatus               @default(DND) @map("agent_status")
  title                   String?                   @db.VarChar(100)
  bio                     String?
  timezone                String                    @default("UTC") @db.VarChar(50)
  language                String                    @default("tr") @db.VarChar(10)
  maxActiveTickets        Int                       @default(5) @map("max_active_tickets")
  agentSkills             AgentSkill[]
  aiInteractions          AiInteraction[]
  announcementTemplates   AnnouncementTemplate[]    @relation("TemplateAuthor")
  announcements           Announcement[]
  articleFeedbacks        ArticleFeedback[]
  auditLogs               AuditLog[]
  availability            AvailabilityOverride[]
  customerProfile         CustomerProfile?
  emailPreferences        EmailPreference[]
  feedbacks               InteractionFeedback[]
  articleVersions         KnowledgeArticleVersion[]
  articlesApproved        KnowledgeArticle[]        @relation("ArticleApprovedBy")
  articlesCreated         KnowledgeArticle[]        @relation("ArticleCreatedBy")
  macrosCreated           Macro[]
  notifications           Notification[]
  settings                Setting[]
  shifts                  Shift[]
  teamMembers             TeamMember[]
  ticketEscalations       TicketEscalation[]
  ticketMessages          TicketMessage[]
  ticketsAssigned         Ticket[]                  @relation("TicketAssignedTo")
  ticketsCreated          Ticket[]                  @relation("TicketCreatedBy")
  trainingReviews         TrainingQueue[]
  role                    Role?                     @relation(fields: [roleId], references: [id])
  proactiveChatAsAgent    ProactiveChatSession[]    @relation("ProactiveChatAgent")
  proactiveChatAsCustomer ProactiveChatSession[]    @relation("ProactiveChatCustomer")
  proactiveChatMessages   ProactiveChatMessage[]    @relation("ProactiveChatMessageSender")

  @@map("users")
}

model Department {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @db.VarChar(100)
  slug        String      @db.VarChar(100)
  description String?
  color       String?     @db.VarChar(7)
  icon        String?     @db.VarChar(50)
  isDefault   Boolean     @default(false) @map("is_default")
  isActive    Boolean     @default(true) @map("is_active")
  isArchived  Boolean     @default(false) @map("is_archived")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")
  slaPolicies SlaPolicy[]
  teams       Team[]
  tickets     Ticket[]

  @@map("departments")
}

model Team {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId          String             @map("department_id") @db.Uuid
  name                  String             @db.VarChar(100)
  slug                  String             @db.VarChar(100)
  description           String?
  isArchived            Boolean            @default(false) @map("is_archived")
  autoAssignmentEnabled Boolean            @default(false) @map("auto_assignment_enabled")
  assignmentStrategy    AssignmentStrategy @default(MANUAL) @map("assignment_strategy")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  deletedAt             DateTime?          @map("deleted_at")
  members               TeamMember[]
  department            Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("teams")
}

model TeamMember {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  teamId       String      @map("team_id") @db.Uuid
  roleOverride SystemRole? @map("role_override")
  joinedAt     DateTime    @default(now()) @map("joined_at")
  team         Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@map("team_members")
}

model Skill {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @unique @db.VarChar(100)
  category    String?      @db.VarChar(100)
  createdAt   DateTime     @default(now()) @map("created_at")
  agentSkills AgentSkill[]

  @@map("skills")
}

model AgentSkill {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  skillId     String   @map("skill_id") @db.Uuid
  proficiency Int      @default(3)
  createdAt   DateTime @default(now()) @map("created_at")
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("agent_skills")
}

model Shift {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week") @db.SmallInt
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  timezone  String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shifts")
}

model AvailabilityOverride {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  date        DateTime @db.Date
  isAvailable Boolean  @map("is_available")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("availability_overrides")
}

model SlaPolicy {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String         @db.VarChar(100)
  departmentId         String         @map("department_id") @db.Uuid
  priority             TicketPriority
  firstResponseMinutes Int            @map("first_response_minutes")
  resolutionMinutes    Int            @map("resolution_minutes")
  businessHoursOnly    Boolean        @default(true) @map("business_hours_only")
  createdAt            DateTime       @default(now()) @map("created_at")
  department           Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("sla_policies")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(255)
  message   String
  type      String   @default("SYSTEM") @db.VarChar(50)
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead], map: "idx_notifications_user_read")
  @@map("notifications")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique @db.VarChar(100)
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique @db.VarChar(100)
  description String?
  group       String           @db.VarChar(50)
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model CustomerProfile {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String            @unique @map("user_id") @db.Uuid
  firstName         String            @map("first_name") @db.VarChar(100)
  lastName          String            @map("last_name") @db.VarChar(100)
  middleName        String?           @map("middle_name") @db.VarChar(100)
  customerNo        String            @unique @map("customer_no") @db.VarChar(50)
  companyName       String            @map("company_name") @db.VarChar(255)
  accountId         String?           @map("account_id") @db.Uuid
  industry          String?           @db.VarChar(255)
  jobTitle          String?           @map("job_title") @db.VarChar(255)
  phoneNumber       String?           @map("phone_number") @db.VarChar(50)
  contractStatus    String?           @map("contract_status") @db.VarChar(100)
  externalContactId String?           @unique @map("external_contact_id") @db.VarChar(255)
  crmVerified       Boolean           @default(false) @map("crm_verified")
  hotinfoData       Json?             @map("hotinfo_data")
  hotinfoRaw        String?           @map("hotinfo_raw")
  hotinfoUpdatedAt  DateTime?         @map("hotinfo_updated_at")
  tags              String[]          @default([])
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  subscriptionModel String?           @map("subscription_model") @db.VarChar(100)
  deletedAt         DateTime?         @map("deleted_at")
  isVip             Boolean           @default(false) @map("is_vip")
  announcementLogs  AnnouncementLog[]
  account           CrmAccount?       @relation(fields: [accountId], references: [id])
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyName], map: "idx_customer_company")
  @@index([externalContactId], map: "idx_customer_external_id")
  @@index([createdAt], map: "idx_customer_created")
  @@map("customer_profiles")
}

model CrmAccount {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String            @db.VarChar(255)
  industry          String?           @db.VarChar(255)
  website           String?           @db.VarChar(255)
  address           String?
  externalAccountId String?           @unique @map("external_account_id") @db.VarChar(255)
  crmVerified       Boolean           @default(false) @map("crm_verified")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  account_number    String?           @db.VarChar(255)
  customers         CustomerProfile[]

  @@map("crm_accounts")
}

model CrmConnection {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider      CrmProvider
  tenantId      String?      @map("tenant_id") @db.VarChar(255)
  clientId      String?      @map("client_id") @db.VarChar(255)
  clientSecret  String?      @map("client_secret")
  webhookSecret String?      @map("webhook_secret")
  instanceUrl   String?      @map("instance_url") @db.VarChar(255)
  isActive      Boolean      @default(true) @map("is_active")
  syncSettings  Json?        @map("sync_settings")
  lastSyncAt    DateTime?    @map("last_sync_at")
  syncStatus    SyncStatus   @default(IDLE) @map("sync_status")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")
  syncLogs      CrmSyncLog[]

  @@map("crm_connections")
}

model CrmSyncLog {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId String        @map("connection_id") @db.Uuid
  status       SyncStatus
  startedAt    DateTime      @default(now()) @map("started_at")
  completedAt  DateTime?     @map("completed_at")
  totalRecords Int           @default(0) @map("total_records")
  successCount Int           @default(0) @map("success_count")
  errorCount   Int           @default(0) @map("error_count")
  errorMessage String?       @map("error_message")
  details      Json?
  connection   CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("crm_sync_logs")
}

model Setting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updater   User?    @relation(fields: [updatedBy], references: [id])

  @@map("settings")
}

model PromptTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  content     String
  description String?
  version     Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("prompt_templates")
}

model Category {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String             @db.VarChar(255)
  slug        String             @unique @db.VarChar(255)
  parentId    String?            @map("parent_id") @db.Uuid
  description String?
  sortOrder   Int                @default(0) @map("sort_order")
  createdAt   DateTime           @default(now()) @map("created_at")
  deletedAt   DateTime?          @map("deleted_at")
  parent      Category?          @relation("CategoryParent", fields: [parentId], references: [id])
  children    Category[]         @relation("CategoryParent")
  articles    KnowledgeArticle[]

  @@map("categories")
}

model KnowledgeArticle {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String?                   @map("category_id") @db.Uuid
  title          String
  slug           String                    @db.VarChar(255)
  status         ArticleStatus             @default(DRAFT)
  approved       Boolean                   @default(false)
  approvedBy     String?                   @map("approved_by") @db.Uuid
  approvedAt     DateTime?                 @map("approved_at")
  currentVersion Int                       @default(1) @map("current_version")
  source         String?                   @default("internal") @db.VarChar(50)
  originalId     String?                   @map("original_id") @db.VarChar(255)
  isInternal     Boolean                   @default(false) @map("is_internal")
  isAutoImported Boolean                   @default(false) @map("is_auto_imported")
  trustScore     Decimal                   @default(0.95) @map("trust_score") @db.Decimal(5, 4)
  feedbackWeight Decimal                   @default(1.0) @map("feedback_weight") @db.Decimal(5, 4)
  ageWeight      Decimal                   @default(1.0) @map("age_weight") @db.Decimal(5, 4)
  language       String                    @default("tr") @db.VarChar(10)
  tags           String[]                  @default([])
  viewCount      Int                       @default(0) @map("view_count")
  deletedAt      DateTime?                 @map("deleted_at")
  createdBy      String?                   @map("created_by") @db.Uuid
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  interactions   AiInteraction[]
  feedbacks      ArticleFeedback[]
  versions       KnowledgeArticleVersion[]
  approver       User?                     @relation("ArticleApprovedBy", fields: [approvedBy], references: [id])
  category       Category?                 @relation(fields: [categoryId], references: [id])
  creator        User?                     @relation("ArticleCreatedBy", fields: [createdBy], references: [id])
  embeddings     KnowledgeEmbedding[]

  @@index([status], map: "idx_ka_status")
  @@index([approved], map: "idx_ka_approved")
  @@index([categoryId], map: "idx_ka_category")
  @@map("knowledge_articles")
}

model ArticleFeedback {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId String           @map("article_id") @db.Uuid
  userId    String?          @map("user_id") @db.Uuid
  isHelpful Boolean          @map("is_helpful")
  comment   String?
  createdAt DateTime         @default(now()) @map("created_at")
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id])

  @@map("article_feedbacks")
}

model KnowledgeArticleVersion {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId     String               @map("article_id") @db.Uuid
  version       Int
  title         String
  content       String
  contentPlain  String               @map("content_plain")
  changeSummary String?              @map("change_summary")
  createdBy     String?              @map("created_by") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at")
  interactions  AiInteraction[]      @relation("MatchedVersion")
  article       KnowledgeArticle     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  creator       User?                @relation(fields: [createdBy], references: [id])
  embeddings    KnowledgeEmbedding[]

  @@unique([articleId, version])
  @@index([articleId], map: "idx_kav_article")
  @@map("knowledge_article_versions")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model KnowledgeEmbedding {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId            String                  @map("article_id") @db.Uuid
  articleVersionId     String                  @map("article_version_id") @db.Uuid
  parentId             String?                 @map("parent_id") @db.Uuid
  embedding            Unsupported("vector")
  content              String
  sequence             Int                     @default(0)
  modelName            String                  @map("model_name") @db.VarChar(100)
  isActive             Boolean                 @default(true) @map("is_active")
  embeddingGeneratedAt DateTime                @default(now()) @map("embedding_generated_at")
  embeddingVersion     String                  @default("v1") @map("embedding_version") @db.VarChar(10)
  embeddingDim         Int                     @default(1536) @map("embedding_dim")
  migratedAt           DateTime?               @map("migrated_at")
  article              KnowledgeArticle        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleVersion       KnowledgeArticleVersion @relation(fields: [articleVersionId], references: [id], onDelete: Cascade)

  @@index([articleId], map: "idx_ke_article")
  @@index([embedding], map: "knowledge_embeddings_vector_hnsw_idx")
  @@map("knowledge_embeddings")
}

model AiInteraction {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String?                  @map("session_id") @db.Uuid
  userId            String?                  @map("user_id") @db.Uuid
  userQuery         String                   @map("user_query")
  matchedArticleId  String?                  @map("matched_article_id") @db.Uuid
  matchedVersionId  String?                  @map("matched_version_id") @db.Uuid
  similarityScore   Decimal?                 @map("similarity_score") @db.Decimal(5, 4)
  confidenceBand    ConfidenceBand?          @map("confidence_band")
  responseGenerated String?                  @map("response_generated")
  autoAnswered      Boolean                  @default(false) @map("auto_answered")
  ticketCreated     Boolean                  @default(false) @map("ticket_created")
  productId         String?                  @map("product_id") @db.Uuid
  userContext       Json?                    @map("user_context")
  isAccepted        Boolean?                 @map("is_accepted")
  editedResponse    String?                  @map("edited_response")
  provider          String?                  @db.VarChar(50)
  model             String?                  @db.VarChar(100)
  inputTokens       Int?                     @map("input_tokens")
  outputTokens      Int?                     @map("output_tokens")
  totalTokens       Int?                     @map("total_tokens")
  estimatedCost     Decimal?                 @map("estimated_cost") @db.Decimal(10, 6)
  createdAt         DateTime                 @default(now()) @map("created_at")
  channel           CommunicationChannel     @default(WEB)
  matchedArticle    KnowledgeArticle?        @relation(fields: [matchedArticleId], references: [id])
  matchedVersion    KnowledgeArticleVersion? @relation("MatchedVersion", fields: [matchedVersionId], references: [id])
  product           Product?                 @relation(fields: [productId], references: [id])
  user              User?                    @relation(fields: [userId], references: [id])
  feedbacks         InteractionFeedback[]
  ticket            Ticket?
  trainingQueue     TrainingQueue[]
  shiftDetections   AiShiftDetection[]

  @@index([sessionId], map: "idx_ai_session")
  @@index([matchedArticleId], map: "idx_ai_article")
  @@index([createdAt(sort: Desc)], map: "idx_ai_created")
  @@index([createdAt(sort: Desc), confidenceBand], map: "idx_ai_interactions_created_confidence")
  @@index([userContext], map: "idx_ai_context", type: Gin)
  @@map("ai_interactions")
}

model AiShiftDetection {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interactionId    String?        @map("interaction_id") @db.Uuid
  interaction      AiInteraction? @relation(fields: [interactionId], references: [id])
  userId           String?        @map("user_id")
  detectedAt       DateTime       @default(now()) @map("detected_at")
  previousKeywords String[]       @map("previous_keywords")
  newKeywords      String[]       @map("new_keywords")
  historyLength    Int            @map("history_length")
  confirmed        Boolean        @default(false)

  @@map("ai_shift_detections")
}

model AiResponseCache {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queryHash        String                 @unique @map("query_hash")
  queryEmbedding   Unsupported("vector")? @map("query_embedding")
  embeddingVersion String?                @map("embedding_version") @db.VarChar(10)
  response         Json
  tenantId         String                 @map("tenant_id") @db.Uuid
  userId           String?                @map("user_id") @db.Uuid
  confidence       String                 @db.VarChar(20)
  createdAt        DateTime               @default(now()) @map("created_at")
  expiresAt        DateTime               @map("expires_at")

  @@index([queryHash], map: "idx_cache_hash")
  @@index([tenantId], map: "idx_cache_tenant")
  @@index([expiresAt], map: "idx_cache_expires")
  @@map("ai_response_cache")
}

model InteractionFeedback {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interactionId        String         @map("interaction_id") @db.Uuid
  userId               String?        @map("user_id") @db.Uuid
  isHelpful            Boolean?       @map("is_helpful")
  rating               Int?           @db.SmallInt
  comment              String?
  addedToTrainingQueue Boolean        @default(false) @map("added_to_training_queue")
  createdAt            DateTime       @default(now()) @map("created_at")
  interaction          AiInteraction  @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  user                 User?          @relation(fields: [userId], references: [id])
  trainingQueue        TrainingQueue?

  @@map("interaction_feedbacks")
}

model TrainingQueue {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interactionId  String?              @map("interaction_id") @db.Uuid
  feedbackId     String?              @unique @map("feedback_id") @db.Uuid
  status         TrainingQueueStatus  @default(PENDING)
  reviewedBy     String?              @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?            @map("reviewed_at")
  resolutionNote String?              @map("resolution_note")
  createdAt      DateTime             @default(now()) @map("created_at")
  feedback       InteractionFeedback? @relation(fields: [feedbackId], references: [id])
  interaction    AiInteraction?       @relation(fields: [interactionId], references: [id])
  reviewer       User?                @relation(fields: [reviewedBy], references: [id])

  @@index([status], map: "idx_tq_status")
  @@map("training_queue")
}

model Ticket {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketNumber        String               @unique @map("ticket_number") @db.VarChar(20)
  interactionId       String?              @unique @map("interaction_id") @db.Uuid
  userId              String?              @map("user_id") @db.Uuid
  subject             String
  description         String?
  status              TicketStatus         @default(NEW)
  priority            TicketPriority       @default(MEDIUM)
  assignedTo          String?              @map("assigned_to") @db.Uuid
  tags                String[]             @default([])
  productId           String?              @map("product_id") @db.Uuid
  suggestedCategories String[]             @default([]) @map("suggested_categories")
  hotinfoSnapshot     Json?                @map("hotinfo_snapshot")
  channel             CommunicationChannel @default(WEB)
  chatStatus          ChatStatus           @default(NORMAL) @map("chat_status")
  departmentId        String?              @map("department_id") @db.Uuid
  slaWarningSentAt    DateTime?            @map("sla_warning_sent_at")
  slaResponseDue      DateTime?            @map("sla_response_due")
  slaResolveDue       DateTime?            @map("sla_resolve_due")
  slaRespondedAt      DateTime?            @map("sla_responded_at")
  slaSolvedAt         DateTime?            @map("sla_solved_at")
  isSlaBreached       Boolean              @default(false) @map("is_sla_breached")
  escalated           Boolean              @default(false)
  escalationCount     Int                  @default(0) @map("escalation_count")
  resolvedAt          DateTime?            @map("resolved_at")
  closedAt            DateTime?            @map("closed_at")
  satisfactionScore   Int?                 @map("satisfaction_score")
  satisfactionComment String?              @map("satisfaction_comment")
  knowledgeBaseAdded  Boolean              @default(false) @map("knowledge_base_added")
  parentId            String?              @map("parent_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  embeddings          TicketEmbedding[]
  escalations         TicketEscalation[]
  messages            TicketMessage[]
  assignee            User?                @relation("TicketAssignedTo", fields: [assignedTo], references: [id])
  department          Department?          @relation(fields: [departmentId], references: [id])
  interaction         AiInteraction?       @relation(fields: [interactionId], references: [id])
  parentTicket        Ticket?              @relation("TicketHierarchy", fields: [parentId], references: [id])
  linkedTickets       Ticket[]             @relation("TicketHierarchy")
  product             Product?             @relation(fields: [productId], references: [id])
  creator             User?                @relation("TicketCreatedBy", fields: [userId], references: [id])

  @@index([status], map: "idx_tickets_status")
  @@index([assignedTo], map: "idx_tickets_assigned")
  @@index([priority], map: "idx_tickets_priority")
  @@index([isSlaBreached], map: "idx_tickets_sla")
  @@index([createdAt], map: "idx_tickets_created_at")
  @@index([status, createdAt], map: "idx_tickets_status_created_at")
  @@index([assignedTo, status], map: "idx_tickets_assigned_status")
  @@index([departmentId], map: "idx_tickets_department")
  @@index([hotinfoSnapshot], map: "idx_tickets_hotinfo", type: Gin)
  @@map("tickets")
}

