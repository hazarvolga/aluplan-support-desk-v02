// =============================================
// Prisma Schema — Aluplan Support Desk
// =============================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public"), uuid_ossp(map: "uuid-ossp", schema: "public")]
}

// =============================================
// ENUMS
// =============================================

enum AgentStatus {
  ONLINE
  AWAY
  DND
}

enum AssignmentStrategy {
  MANUAL
  ROUND_ROBIN
  SKILL_BASED
}

enum SystemRole {
  ADMIN
  DEPARTMENT_MANAGER
  TEAM_LEAD
  SENIOR_AGENT
  AGENT
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TicketStatus {
  NEW
  DRAFT
  OPEN
  PENDING_CUSTOMER
  IN_PROGRESS
  PENDING_CUSTOMER_REVIEW
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ConfidenceBand {
  HIGH // > 0.90
  MEDIUM // 0.80 - 0.90
  LOW // < 0.80
}

enum FaqStatus {
  PENDING_REVIEW
  PUBLISHED
  DISMISSED
}

enum TrainingQueueStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum MailProvider {
  RESEND
  SMTP
  MAILGUN
  SENDGRID
}

enum CommunicationChannel {
  EMAIL
  WEB
  WHATSAPP
  API
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

// =============================================
// USERS & RBAC
// =============================================

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String     @unique @db.VarChar(255)
  fullName         String     @db.VarChar(255)
  passwordHash     String     @db.Text
  refreshTokenHash String?    @map("refresh_token_hash") @db.Text
  avatarUrl        String?    @db.Text
  status           UserStatus @default(ACTIVE)
  deletedAt        DateTime?  @map("deleted_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  role             SystemRole @default(AGENT)
  agentStatus      AgentStatus @default(DND) @map("agent_status")
  title            String?    @db.VarChar(100)
  bio              String?    @db.Text
  timezone         String     @default("UTC") @db.VarChar(50)
  language         String     @default("tr") @db.VarChar(10)
  maxActiveTickets Int        @default(5) @map("max_active_tickets")

  // Relations
  teamMembers       TeamMember[]
  agentSkills       AgentSkill[]
  shifts            Shift[]
  availability      AvailabilityOverride[]
  ticketsCreated    Ticket[]               @relation("TicketCreatedBy")
  ticketsAssigned   Ticket[]               @relation("TicketAssignedTo")
  ticketMessages    TicketMessage[]
  ticketEscalations TicketEscalation[]
  articlesCreated   KnowledgeArticle[]     @relation("ArticleCreatedBy")
  articlesApproved  KnowledgeArticle[]     @relation("ArticleApprovedBy")
  articleVersions   KnowledgeArticleVersion[]
  aiInteractions    AiInteraction[]
  feedbacks         InteractionFeedback[]
  articleFeedbacks  ArticleFeedback[]
  trainingReviews   TrainingQueue[]
  auditLogs         AuditLog[]
  settings          Setting[]
  macrosCreated     Macro[]
  customerProfile   CustomerProfile?
  notifications     Notification[]
  emailPreferences  EmailPreference[]

  @@map("users")
}

model Department {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  color       String?  @db.VarChar(7) // hex color
  icon        String?  @db.VarChar(50) // lucide icon name
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  teams       Team[]
  slaPolicies SlaPolicy[]
  tickets     Ticket[]

  @@map("departments")
}

model Team {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId           String             @map("department_id") @db.Uuid
  name                   String             @db.VarChar(100)
  slug                   String             @unique @db.VarChar(100)
  description            String?            @db.Text
  isArchived             Boolean            @default(false) @map("is_archived")
  autoAssignmentEnabled  Boolean            @default(false) @map("auto_assignment_enabled")
  assignmentStrategy     AssignmentStrategy @default(MANUAL) @map("assignment_strategy")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  department Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  members    TeamMember[]

  @@map("teams")
}

model TeamMember {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  teamId        String      @map("team_id") @db.Uuid
  roleOverride  SystemRole? @map("role_override")
  joinedAt      DateTime    @default(now()) @map("joined_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@map("team_members")
}

model Skill {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  category  String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  agentSkills AgentSkill[]

  @@map("skills")
}

model AgentSkill {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  skillId     String   @map("skill_id") @db.Uuid
  proficiency Int      @default(3) // 1-5
  createdAt   DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("agent_skills")
}

model Shift {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week") @db.SmallInt // 0=Sunday, 6=Saturday
  startTime  String   @map("start_time") // Using string for simple TIME storage or specific format
  endTime    String   @map("end_time")
  timezone   String?  @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shifts")
}

model AvailabilityOverride {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  date        DateTime @db.Date
  isAvailable Boolean  @map("is_available")
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("availability_overrides")
}

model SlaPolicy {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String         @db.VarChar(100)
  departmentId         String         @map("department_id") @db.Uuid
  priority             TicketPriority
  firstResponseMinutes Int            @map("first_response_minutes")
  resolutionMinutes    Int            @map("resolution_minutes")
  businessHoursOnly    Boolean        @default(true) @map("business_hours_only")
  createdAt            DateTime       @default(now()) @map("created_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("sla_policies")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(255)
  message   String   @db.Text
  type      String   @default("SYSTEM") @db.VarChar(50) // e.g., TICKET_ASSIGNED, INFO
  isRead    Boolean  @default(false) @map("is_read")
  link      String?  @db.Text // URL or deep link to the resource
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead], map: "idx_notifications_user_read")
  @@map("notifications")
}

// Role and Permission models removed to simplify for ENUM usage in this single-org phase.
// In the future, if dynamic permissions are needed, they can be reintroduced.

// =============================================
// CUSTOMER PROFILES (CRM Integration)
// =============================================

model CustomerProfile {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String    @map("first_name") @db.VarChar(100)
  lastName          String    @map("last_name") @db.VarChar(100)
  middleName        String?   @map("middle_name") @db.VarChar(100)
  customerNo        String    @unique @map("customer_no") @db.VarChar(50) // CRM ID (e.g. C300 XX XX XX)
  companyName       String    @map("company_name") @db.VarChar(255)
  accountId         String?   @map("account_id") @db.Uuid
  account           CrmAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  industry          String?   @db.VarChar(255)
  jobTitle          String?   @map("job_title") @db.VarChar(255)
  phoneNumber       String?   @map("phone_number") @db.VarChar(50)
  contractStatus    String?   @map("contract_status") @db.VarChar(100)
  subscriptionModel String?   @map("subscription_model") @db.VarChar(100)
  externalContactId String?   @unique @map("external_contact_id") @db.VarChar(255)
  crmVerified       Boolean   @default(false) @map("crm_verified")
  hotinfoData       Json?     @map("hotinfo_data")
  hotinfoUpdatedAt  DateTime? @map("hotinfo_updated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("customer_profiles")
}

model CrmAccount {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String            @db.VarChar(255)
  industry          String?           @db.VarChar(255)
  website           String?           @db.VarChar(255)
  address           String?           @db.Text
  externalAccountId String?           @unique @map("external_account_id") @db.VarChar(255)
  crmVerified       Boolean           @default(false) @map("crm_verified")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  customers         CustomerProfile[]

  @@map("crm_accounts")
}

// =============================================
// CRM INTEGRATION (MULTI-PROVIDER)
// =============================================

model CrmConnection {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider      CrmProvider @unique
  tenantId      String?     @map("tenant_id") @db.VarChar(255)
  clientId      String?     @map("client_id") @db.VarChar(255)
  clientSecret  String?     @map("client_secret") @db.Text
  instanceUrl   String?     @map("instance_url") @db.VarChar(255)
  isActive      Boolean     @default(true) @map("is_active")
  syncSettings  Json?       @map("sync_settings")
  lastSyncAt    DateTime?   @map("last_sync_at")
  syncStatus    SyncStatus  @default(IDLE) @map("sync_status")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  syncLogs      CrmSyncLog[]

  @@map("crm_connections")
}

model CrmSyncLog {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId    String        @map("connection_id") @db.Uuid
  connection      CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  status          SyncStatus
  startedAt       DateTime      @default(now()) @map("started_at")
  completedAt     DateTime?     @map("completed_at")
  totalRecords    Int           @default(0) @map("total_records")
  successCount    Int           @default(0) @map("success_count")
  errorCount      Int           @default(0) @map("error_count")
  errorMessage    String?       @map("error_message") @db.Text
  details         Json?         // Detailed record-level results

  @@map("crm_sync_logs")
}

enum CrmProvider {
  DYNAMICS_365
  SALESFORCE
  HUBSPOT
  CUSTOM_WEBHOOK
}

enum SyncStatus {
  IDLE
  SYNCING
  SUCCESS
  ERROR
}

// =============================================
// SETTINGS (Email provider config, branding, etc.)
// =============================================

model Setting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text // JSON string — encrypted for sensitive values
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  updater User? @relation(fields: [updatedBy], references: [id])

  @@map("settings")
}

// =============================================
// AI PROMPT MANAGEMENT (VERSIONING)
// =============================================

model PromptTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  content     String   @db.Text
  description String?  @db.Text
  version     Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("prompt_templates")
}

// =============================================
// KNOWLEDGE BASE
// =============================================

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  parentId    String?  @map("parent_id") @db.Uuid
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  parent   Category?          @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[]         @relation("CategoryParent")
  articles KnowledgeArticle[]

  @@map("categories")
}

model KnowledgeArticle {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String?       @map("category_id") @db.Uuid
  title          String        @db.Text
  slug           String        @unique @db.VarChar(255)
  status         ArticleStatus @default(DRAFT)
  approved       Boolean       @default(false)
  approvedBy     String?       @map("approved_by") @db.Uuid
  approvedAt     DateTime?     @map("approved_at")
  currentVersion Int           @default(1) @map("current_version")
  isInternal     Boolean       @default(false) @map("is_internal")
  isAutoImported Boolean       @default(false) @map("is_auto_imported")
  trustScore     Decimal       @default(0.95) @map("trust_score") @db.Decimal(5, 4)
  feedbackWeight Decimal       @default(1.0) @map("feedback_weight") @db.Decimal(5, 4)
  ageWeight      Decimal       @default(1.0) @map("age_weight") @db.Decimal(5, 4)
  language       String        @default("tr") @db.VarChar(10)
  tags           String[]      @default([])
  viewCount      Int           @default(0) @map("view_count")
  deletedAt      DateTime?     @map("deleted_at")
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  category     Category?                 @relation(fields: [categoryId], references: [id])
  creator      User?                     @relation("ArticleCreatedBy", fields: [createdBy], references: [id])
  approver     User?                     @relation("ArticleApprovedBy", fields: [approvedBy], references: [id])
  versions     KnowledgeArticleVersion[]
  embeddings   KnowledgeEmbedding[]
  interactions AiInteraction[]
  feedbacks    ArticleFeedback[]

  @@index([status], map: "idx_ka_status")
  @@index([approved], map: "idx_ka_approved")
  @@index([categoryId], map: "idx_ka_category")
  @@map("knowledge_articles")
}

model ArticleFeedback {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  isHelpful Boolean  @map("is_helpful")
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User?            @relation(fields: [userId], references: [id])

  @@map("article_feedbacks")
}

model KnowledgeArticleVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId     String   @map("article_id") @db.Uuid
  version       Int
  title         String   @db.Text
  content       String   @db.Text // Raw markdown/HTML
  contentPlain  String   @map("content_plain") @db.Text // Cleaned for embedding
  changeSummary String?  @map("change_summary") @db.Text
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  article      KnowledgeArticle     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  creator      User?                @relation(fields: [createdBy], references: [id])
  embeddings   KnowledgeEmbedding[]
  interactions AiInteraction[]      @relation("MatchedVersion")

  @@unique([articleId, version])
  @@index([articleId], map: "idx_kav_article")
  @@map("knowledge_article_versions")
}

model KnowledgeEmbedding {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId            String                     @map("article_id") @db.Uuid
  articleVersionId     String                     @map("article_version_id") @db.Uuid
  parentId             String?                    @map("parent_id") @db.Uuid
  embedding            Unsupported("vector(768)")
  content              String                     @db.Text
  sequence             Int                        @default(0)
  modelName            String                     @map("model_name") @db.VarChar(100)
  isActive             Boolean                    @default(true) @map("is_active")
  embeddingGeneratedAt DateTime                   @default(now()) @map("embedding_generated_at")

  article        KnowledgeArticle        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleVersion KnowledgeArticleVersion @relation(fields: [articleVersionId], references: [id], onDelete: Cascade)

  @@index([articleId], map: "idx_ke_article")
  @@map("knowledge_embeddings")
}

// =============================================
// AI INTERACTION & QUERY LOG
// =============================================

model AiInteraction {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String?         @map("session_id") @db.Uuid
  userId            String?         @map("user_id") @db.Uuid
  userQuery         String          @map("user_query") @db.Text
  matchedArticleId  String?         @map("matched_article_id") @db.Uuid
  matchedVersionId  String?         @map("matched_version_id") @db.Uuid
  similarityScore   Decimal?        @map("similarity_score") @db.Decimal(5, 4)
  confidenceBand    ConfidenceBand? @map("confidence_band")
  responseGenerated String?         @map("response_generated") @db.Text
  autoAnswered      Boolean         @default(false) @map("auto_answered")
  ticketCreated     Boolean         @default(false) @map("ticket_created")
  productId         String?         @map("product_id") @db.Uuid
  userContext       Json?           @map("user_context") // page, segment, etc.

  // Telemetry details
  isAccepted     Boolean? @map("is_accepted")
  editedResponse String?  @map("edited_response") @db.Text

  // Token usage and Cost telemetry
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  totalTokens   Int?     @map("total_tokens")
  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(10, 6)

  createdAt DateTime @default(now()) @map("created_at")

  user           User?                    @relation(fields: [userId], references: [id])
  product        Product?                 @relation(fields: [productId], references: [id])
  matchedArticle KnowledgeArticle?        @relation(fields: [matchedArticleId], references: [id])
  matchedVersion KnowledgeArticleVersion? @relation("MatchedVersion", fields: [matchedVersionId], references: [id])
  feedbacks      InteractionFeedback[]
  trainingQueue  TrainingQueue[]
  ticket         Ticket?

  @@index([sessionId], map: "idx_ai_session")
  @@index([matchedArticleId], map: "idx_ai_article")
  @@index([createdAt(sort: Desc)], map: "idx_ai_created")
  @@map("ai_interactions")
}

// =============================================
// FEEDBACK & TRAINING
// =============================================

model InteractionFeedback {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interactionId        String   @map("interaction_id") @db.Uuid
  userId               String?  @map("user_id") @db.Uuid
  isHelpful            Boolean? @map("is_helpful")
  rating               Int?     @db.SmallInt // 1-5
  comment              String?  @db.Text
  addedToTrainingQueue Boolean  @default(false) @map("added_to_training_queue")
  createdAt            DateTime @default(now()) @map("created_at")

  interaction   AiInteraction  @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id])
  trainingQueue TrainingQueue?

  @@map("interaction_feedbacks")
}

model TrainingQueue {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interactionId  String?             @map("interaction_id") @db.Uuid
  feedbackId     String?             @unique @map("feedback_id") @db.Uuid
  status         TrainingQueueStatus @default(PENDING)
  reviewedBy     String?             @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?           @map("reviewed_at")
  resolutionNote String?             @map("resolution_note") @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")

  interaction AiInteraction?       @relation(fields: [interactionId], references: [id])
  feedback    InteractionFeedback? @relation(fields: [feedbackId], references: [id])
  reviewer    User?                @relation(fields: [reviewedBy], references: [id])

  @@index([status], map: "idx_tq_status")
  @@map("training_queue")
}

// =============================================
// SUPPORT TICKETS
// =============================================

model Ticket {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketNumber        String               @unique @map("ticket_number") @db.VarChar(20) // SUP-00001
  interactionId       String?              @unique @map("interaction_id") @db.Uuid
  userId              String?              @map("user_id") @db.Uuid
  subject             String               @db.Text
  description         String?              @db.Text
  status              TicketStatus         @default(NEW)
  priority            TicketPriority       @default(MEDIUM)
  assignedTo          String?              @map("assigned_to") @db.Uuid
  tags                String[]             @default([])
  productId           String?              @map("product_id") @db.Uuid
  suggestedCategories String[]             @default([]) @map("suggested_categories")
  hotinfoSnapshot     Json?                @map("hotinfo_snapshot")
  channel             CommunicationChannel @default(WEB)
  departmentId        String?              @map("department_id") @db.Uuid

  // SLA Fields
  slaResponseDue DateTime? @map("sla_response_due")
  slaResolveDue  DateTime? @map("sla_resolve_due")
  slaRespondedAt DateTime? @map("sla_responded_at")
  slaSolvedAt    DateTime? @map("sla_solved_at")
  isSlaBreached  Boolean   @default(false) @map("is_sla_breached")

  // Escalation
  escalated       Boolean @default(false)
  escalationCount Int     @default(0) @map("escalation_count")

  resolvedAt DateTime? @map("resolved_at")
  closedAt   DateTime? @map("closed_at")

  // CSAT / Self-Learning Feedback
  satisfactionScore   Int?    @map("satisfaction_score") // 1-5
  satisfactionComment String? @map("satisfaction_comment") @db.Text
  knowledgeBaseAdded  Boolean @default(false) @map("knowledge_base_added")

  // Ticket Linking
  parentId String? @map("parent_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator       User?              @relation("TicketCreatedBy", fields: [userId], references: [id])
  assignee      User?              @relation("TicketAssignedTo", fields: [assignedTo], references: [id])
  interaction   AiInteraction?     @relation(fields: [interactionId], references: [id])
  product       Product?           @relation(fields: [productId], references: [id])
  parentTicket  Ticket?            @relation("TicketHierarchy", fields: [parentId], references: [id])
  linkedTickets Ticket[]           @relation("TicketHierarchy")
  messages      TicketMessage[]
  escalations   TicketEscalation[]
  embeddings    TicketEmbedding[]
  department    Department?        @relation(fields: [departmentId], references: [id])

  @@index([status], map: "idx_tickets_status")
  @@index([assignedTo], map: "idx_tickets_assigned")
  @@index([priority], map: "idx_tickets_priority")
  @@index([isSlaBreached], map: "idx_tickets_sla")
  @@map("tickets")
}

model TicketMessage {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String               @map("ticket_id") @db.Uuid
  senderId   String?              @map("sender_id") @db.Uuid // Null = system/agent note
  message    String               @db.Text
  isInternal Boolean              @default(false) @map("is_internal")
  channel    CommunicationChannel @default(WEB)
  sentiment  Sentiment? // AI classification
  metadata   Json? // For translations, etc.
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User?        @relation(fields: [senderId], references: [id])
  attachments Attachment[]

  @@map("ticket_messages")
}

model Attachment {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String        @map("message_id") @db.Uuid
  message   TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String        @map("file_name") @db.VarChar(255)
  fileSize  Int           @map("file_size")
  mimeType  String        @map("mime_type") @db.VarChar(100)
  url       String        @db.Text // Storage path or URL
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([messageId], map: "idx_attachment_message")
  @@map("attachments")
}

model TicketEscalation {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId     String         @map("ticket_id") @db.Uuid
  escalatedBy  String?        @map("escalated_by") @db.Uuid
  fromPriority TicketPriority @map("from_priority")
  toPriority   TicketPriority @map("to_priority")
  reason       String?        @db.Text
  createdAt    DateTime       @default(now()) @map("created_at")

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  escalator User?  @relation(fields: [escalatedBy], references: [id])

  @@map("ticket_escalations")
}

// =============================================
// FAQ (Generated from learning pipeline)
// =============================================

model FaqEntry {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question        String    @db.Text
  answer          String    @db.Text
  status          FaqStatus @default(PENDING_REVIEW)
  confidenceScore Decimal   @map("confidence_score") @db.Decimal(5, 4) // 0.0000 - 1.0000
  frequency       Int       @default(1) // How many times this was seen
  isInternal      Boolean   @default(true) @map("is_internal")
  trustScore      Decimal   @default(0.75) @map("trust_score") @db.Decimal(5, 4)
  feedbackWeight  Decimal   @default(1.0) @map("feedback_weight") @db.Decimal(5, 4)
  sourceTypes     String[]  @default([]) @map("source_types") // ['ticket', 'chat']
  tags            String[]  @default([])
  language        String    @default("tr") @db.VarChar(10)
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status], map: "idx_faq_status")
  @@map("faq_entries")
}

// =============================================
// AUDIT LOG
// =============================================

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100) // 'article.approved', 'ticket.closed', etc.
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([actorId], map: "idx_audit_actor")
  @@index([createdAt(sort: Desc)], map: "idx_audit_created")
  @@map("audit_logs")
}

// =============================================
// AUTOMATION ENGINE
// =============================================

enum RuleTrigger {
  TICKET_CREATED
  MESSAGE_ADDED
}

model TicketRule {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @db.VarChar(100)
  description String?     @db.Text
  isActive    Boolean     @default(true) @map("is_active")
  triggerOn   RuleTrigger @default(TICKET_CREATED) @map("trigger_on")
  conditions  Json // Format: { "subject:contains": "acil", "priority:equals": "HIGH" }
  actions     Json // Format: { "setPriority": "URGENT", "addTag": "acil-talep" }
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("ticket_rules")
}

// =============================================
// PRODUCTIVITY TOOLS (Macros / Canned Responses)
// =============================================

model Macro {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(100)
  content   String   @db.Text
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator User? @relation(fields: [createdBy], references: [id])

  @@map("macros")
}

// =============================================
// EMAIL AUTOMATION TRACKING
// =============================================

model InboundEmailLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId   String    @unique @map("message_id") @db.VarChar(255) // IMAP Message-ID
  from        String    @db.VarChar(255)
  subject     String?   @db.Text
  processed   Boolean   @default(false)
  ticketId    String?   @map("ticket_id") @db.Uuid
  error       String?   @db.Text
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("inbound_email_logs")
}

// =============================================
// WEBHOOK SYSTEM (Outgoing Events)
// =============================================

model Webhook {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(100)
  url       String   @db.Text
  events    String[] // Array of event names like ["ticket.created", "ticket.resolved"]
  secret    String?  @db.VarChar(255) // For signing payloads
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("webhooks")
}

// =============================================
// KNOWLEDGE POOL (Unstructured Data)
// =============================================

enum KnowledgeSourceType {
  URL
  FILE_PDF
  FILE_TXT
  FILE_MD
  FILE_CSV
}

enum KnowledgeSourceStatus {
  INACTIVE
  ACTIVE
  SYNCING
  FAILED
  PENDING_REVIEW
}

model KnowledgeSource {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type         KnowledgeSourceType
  name         String                @db.VarChar(255)
  url          String?               @db.Text
  fileName     String?               @map("file_name") @db.VarChar(255)
  filePath     String?               @map("file_path") @db.Text
  status       KnowledgeSourceStatus @default(ACTIVE)
  productId    String?               @map("product_id") @db.Uuid
  trustScore   Decimal               @default(0.85) @map("trust_score") @db.Decimal(5, 4)
  metadata     Json?                 @db.JsonB
  lastSyncedAt DateTime?             @map("last_synced_at")
  lastEtag     String?               @map("last_etag") @db.VarChar(255)
  lastHash     String?               @map("last_hash") @db.VarChar(255)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  product    Product?                 @relation(fields: [productId], references: [id])
  syncLogs   KnowledgeSourceSyncLog[]
  embeddings KnowledgePoolEmbedding[]

  @@map("knowledge_sources")
}

model KnowledgeSourceSyncLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId        String    @map("source_id") @db.Uuid
  syncStartedAt   DateTime  @default(now()) @map("sync_started_at")
  syncFinishedAt  DateTime? @map("sync_finished_at")
  status          String    @db.VarChar(50) // SUCCESS, FAILED
  error           String?   @db.Text
  chunksProcessed Int       @default(0) @map("chunks_processed")
  newHash         String?   @map("new_hash") @db.VarChar(255)

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("knowledge_source_sync_logs")
}

model KnowledgePoolEmbedding {
  id        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId  String                     @map("source_id") @db.Uuid
  embedding Unsupported("vector(768)")
  content   String                     @db.Text // The raw chunk text
  metadata  Json?                      @db.JsonB
  modelName String                     @map("model_name") @db.VarChar(100)
  createdAt DateTime                   @default(now()) @map("created_at")

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId], map: "idx_kpe_source")
  @@map("knowledge_pool_embeddings")
}

// -----------------------------------------------------
// DIRECTORY / PRODUCTS (Smart Ticket Tagging)
// -----------------------------------------------------

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  categories       ProductCategory[]
  tickets          Ticket[]
  knowledgeSources KnowledgeSource[]
  aiInteractions   AiInteraction[]

  @@map("products")
}

model ProductCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  name      String
  keywords  String[] @default([]) // Keywords for AI context matching
  isActive  Boolean  @default(true) @map("is_active")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "idx_product_categories_product")
  @@map("product_categories")
}

model TicketEmbedding {
  id        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId  String                     @map("ticket_id") @db.Uuid
  embedding Unsupported("vector(768)")
  modelName String                     @map("model_name") @db.VarChar(100)
  createdAt DateTime                   @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId], map: "idx_ticket_embeddings_ticket")
  @@map("ticket_embeddings")
}

// =============================================
// SLA CONFIGURATION (Business Hours & Holidays)
// =============================================

model BusinessHours {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dayOfWeek    Int // 0 (Sunday) to 6 (Saturday)
  startTime    String   @db.VarChar(5) // "09:00"
  endTime      String   @db.VarChar(5) // "18:00"
  isWorkingDay Boolean  @default(true) @map("is_working_day")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([dayOfWeek])
  @@map("business_hours")
}

model Holiday {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date        DateTime @db.Date
  name        String   @db.VarChar(255)
  isRecurring Boolean  @default(false) @map("is_recurring") // If true, only month/day matter
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([date])
  @@map("holidays")
}

// =============================================
// OUTBOUND EMAIL TRACKING & PREFERENCES
// =============================================

model EmailLog {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientEmail String       @map("recipient_email") @db.VarChar(255)
  subject        String       @db.Text
  templateName   String       @map("template_name") @db.VarChar(100)
  provider       MailProvider @default(RESEND)
  messageId      String?      @unique @map("message_id") @db.VarChar(255)
  status         String       @default("PENDING") @db.VarChar(50) // PENDING, SENT, FAILED
  error          String?      @db.Text
  sentAt         DateTime?    @map("sent_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  events EmailEvent[]

  @@index([recipientEmail], map: "idx_email_logs_recipient")
  @@index([templateName], map: "idx_email_logs_template")
  @@map("email_logs")
}

model EmailEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailLogId String   @map("email_log_id") @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(50) // sent, delivered, opened, clicked, bounced, complained
  occurredAt DateTime @map("occurred_at")
  metadata   Json?    @db.JsonB

  emailLog EmailLog @relation(fields: [emailLogId], references: [id], onDelete: Cascade)

  @@index([emailLogId], map: "idx_email_events_log")
  @@map("email_events")
}

model EmailPreference {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emailType String   @map("email_type") @db.VarChar(100)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, emailType])
  @@map("email_preferences")
}
