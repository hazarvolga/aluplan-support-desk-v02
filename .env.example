# =============================================
# Aluplan Support Desk - Environment Variables
# =============================================
# Copy this file to .env for Docker Compose/Coolify, or mirror the same keys in
# your deployment platform. Never commit real secrets.

# Database / cache
POSTGRES_PASSWORD="change-me-local-only"
DATABASE_URL="postgresql://postgres:change-me-local-only@postgres:5432/aluplan_support?schema=public"
REDIS_URL="redis://redis:6379"

# Auth / encryption
JWT_SECRET="replace-with-strong-random-64-char-secret"
JWT_REFRESH_SECRET="replace-with-another-strong-random-64-char-secret"
AUTH_ACTION_JWT_SECRET="replace-with-a-third-strong-random-64-char-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
ENCRYPTION_KEY="replace-with-32-byte-base64-or-hex-key"
ADMIN_BYPASS_EMAILS="admin@example.com"

# Public application URLs
NODE_ENV="production"
PORT=4000
FRONTEND_URL="https://support.example.com"
API_URL="https://api.example.com/api/v1"
NEXT_PUBLIC_API_URL="https://api.example.com/api/v1"
NEXT_INTERNAL_API_URL="http://aluplan_backend:4000/api/v1"
ALLOWED_ORIGINS="https://support.example.com"

# Email
MAIL_PROVIDER="resend"
RESEND_API_KEY=""
MAIL_FROM="destek@example.com"

# AI providers
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-2.5-flash"
GEMINI_EMBED_MODEL="gemini-embedding-2"
LLMAPI_API_KEY=""
LLMAPI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
LLMAPI_CHAT_MODEL="gemini-2.5-flash"
LLMAPI_EMBED_MODEL="gemini-embedding-2"
OPENAI_API_KEY=""
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""
CHAT_PROVIDER="GEMINI"

# RAG / embeddings
EMBEDDING_PROVIDER="GEMINI"
EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_DIMENSIONS=3072
VECTOR_DIMENSIONS=3072
SIMILARITY_THRESHOLD_HIGH=0.75
SIMILARITY_THRESHOLD_MEDIUM=0.70
KNOWLEDGE_SYNC_QUEUE_CONCURRENCY=1
KNOWLEDGE_SYNC_RATE_MAX=1
KNOWLEDGE_SYNC_RATE_DURATION_MS=30000
KNOWLEDGE_SYNC_BULK_DELAY_MS=15000
CRAWL4AI_ENABLED=false
CRAWL4AI_BASE_URL="http://crawl4ai:11235"
CRAWL4AI_API_TOKEN=""
CRAWL4AI_TIMEOUT_MS=45000

# CRM / Dynamics 365
CRM_DELTA_SYNC_INTERVAL="*/5 * * * *"

# Object storage (Cloudflare R2 / S3-compatible)
STORAGE_TYPE="S3"
STORAGE_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
STORAGE_PUBLIC_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="aluplan-storage"
STORAGE_REGION="auto"
STORAGE_USE_PATH_STYLE="true"

# Monitoring / Swagger
SENTRY_ENABLED=false
SENTRY_DSN=""
SWAGGER_PASSWORD=""
