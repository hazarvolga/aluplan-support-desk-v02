# =============================================
# Aluplan Support Desk — Environment Variables
# =============================================
# Copy this file to apps/backend/.env and fill in the values.

# ── Database ─────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aluplan_support?schema=public"
REDIS_URL="redis://localhost:6379"

# ── Authentication ───────────────────────────
JWT_SECRET="your-jwt-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ── Import Credentials ───────────────────────
WP_IMPORT_DEFAULT_PASSWORD="your-secure-import-password"


# ── Application ──────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# ── Email (Optional) ────────────────────────
MAIL_PROVIDER=SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM="Aluplan Destek <noreply@example.com>"

# ── AI Providers ─────────────────────────────
# Set your preferred provider keys here.
OPENAI_API_KEY="sk-..."
GROQ_API_KEY="gsk_..."
ANTHROPIC_API_KEY="sk-ant-..."

# ── RAG Configuration ────────────────────────
# Embedding
EMBEDDING_PROVIDER=OPENAI                     # OPENAI or OLLAMA
EMBEDDING_MODEL=text-embedding-3-small        # If OPENAI
# EMBEDDING_MODEL=bge-m3                      # If OLLAMA
EMBEDDING_DIMENSIONS=1536                     # 1536 for OpenAI, 1024 for BGE-M3

# Retrieval thresholds
SIMILARITY_THRESHOLD=0.78
LOW_CONFIDENCE_THRESHOLD=0.72

# Chunking sizes
CHUNK_PARENT_MAX_TOKENS=800
CHUNK_CHILD_MAX_TOKENS=120

# Re-ranking multipliers
RERANK_MULTIPLIER_ARTICLE=1.30
RERANK_MULTIPLIER_DOCUMENT=1.15
RERANK_MULTIPLIER_URL=0.60
RERANK_URL_HARD_FLOOR=0.75

# ── Object Storage (Cloudflare R2 / S3-Compatible) ─────────────
# Production uses Cloudflare R2. Any S3-compatible provider works.
STORAGE_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY="your-r2-access-key"
STORAGE_SECRET_KEY="your-r2-secret-key"
STORAGE_BUCKET="aluplan-storage"
STORAGE_REGION="auto"                         # "auto" for R2, region for AWS S3
STORAGE_USE_PATH_STYLE="false"                # false for R2, true for MinIO
