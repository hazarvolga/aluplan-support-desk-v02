# =============================================
# Aluplan Support Desk — Environment Variables
# =============================================
# Copy this file to apps/backend/.env and fill in the values.

# ── Database ─────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aluplan_support?schema=public"

# ── Authentication ───────────────────────────
JWT_SECRET="your-jwt-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ── Application ──────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# ── Email (Optional) ────────────────────────
MAIL_PROVIDER=SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM="Aluplan Destek <noreply@example.com>"

# ── AI / Ollama ──────────────────────────────
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
AI_CONFIDENCE_THRESHOLD=0.85
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3

# ── PGVector ─────────────────────────────────
PGVECTOR_DIMENSIONS=768
PGVECTOR_SIMILARITY_THRESHOLD=0.78
