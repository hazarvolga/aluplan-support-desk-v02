{
    "name": "aluplan-support-desk",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "start:full": "bash scripts/start.sh",
        "test": "turbo test",
        "test:all": "turbo test",
        "test:e2e": "pnpm --filter @aluplan/frontend test:e2e",
        "lint": "turbo lint",
        "typecheck": "turbo typecheck",
        "db:generate": "turbo db:generate",
        "db:migrate": "turbo db:migrate",
        "i18n:check": "pnpm --filter @aluplan/frontend i18n:check",
        "spec:verify": "node scripts/verify-specs.mjs"
    },
    "devDependencies": {
        "@types/handlebars": "^4.1.0",
        "@types/mjml": "^4.7.4",
        "@types/multer": "^2.0.0",
        "dotenv": "^17.3.1",
        "pg": "^8.20.0",
        "prettier": "^3.8.1",
        "ts-node": "^10.9.2",
        "turbo": "^2.8.12",
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@9.15.4",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=9.0.0"
    },
    "dependencies": {
        "@nestjs/bullmq": "^12.0.0",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/resources": "^2.6.0",
        "bullmq": "^5.70.1",
        "handlebars": "^4.7.8",
        "ioredis": "^5.10.0",
        "mjml": "^4.18.0",
        "prisma": "7.4.2"
    }
