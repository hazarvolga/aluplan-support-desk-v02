FROM node:22.23.3-alpine3.23@sha256:baf676f7d0e552f3231945c2f979055ca121bce128c152f7a34e6bd1728b1c5a AS base
RUN npm install -g pnpm@9.15.4

FROM base AS builder
# Set working directory
WORKDIR /app
# Force development mode so devDependencies are installed during build
ENV NODE_ENV=development
# Avoid downloading heavy browser binaries during build
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY . .
# Configure pnpm for network resilience
RUN pnpm config set fetch-retries 5 && \
    pnpm config set fetch-retry-mintimeout 20000 && \
    pnpm config set fetch-retry-maxtimeout 120000 && \
    pnpm config set fetch-timeout 120000 && \
    pnpm config set network-concurrency 4 && \
    pnpm config set registry https://registry.npmjs.org/

# Fail closed instead of changing dependency versions during a release build.
RUN pnpm install --frozen-lockfile
# Generate database client
RUN pnpm --filter @aluplan/database db:generate
# Direct filtered builds bypass Turbo's upstream build ordering.
RUN pnpm --filter @aluplan/shared-schemas build
# Next config skips built-in type checking; retain a separate release gate.
RUN pnpm --filter @aluplan/frontend typecheck
# Build arguments
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Reset to production for the Next.js build
ENV NODE_ENV=production
# Build frontend with optimized memory limit (2048) to prevent OOM
RUN NODE_OPTIONS="--max-old-space-size=2048" NEXT_MEMORY_WORKERS=0 NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL pnpm --filter @aluplan/frontend build


FROM node:22.23.3-alpine3.23@sha256:baf676f7d0e552f3231945c2f979055ca121bce128c152f7a34e6bd1728b1c5a AS runner
ARG VCS_REF
RUN test "${#VCS_REF}" -eq 40 && printf '%s' "${VCS_REF}" | grep -Eq '^[0-9a-f]{40}$'
LABEL org.opencontainers.image.revision="${VCS_REF}"
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Fail closed if the runtime OpenSSL security patch is unavailable.
RUN apk add --no-cache --upgrade curl 'libcrypto3>=3.5.8-r0' 'libssl3>=3.5.8-r0'

# Standalone Next.js starts with node; package managers are build-only tools.
# Keep removal paths explicit and confined to this runner stage.
RUN rm -rf /usr/local/lib/node_modules/npm \
    /usr/local/lib/node_modules/pnpm \
    /usr/local/lib/node_modules/corepack \
    /opt/yarn-v1.22.22 \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/pnpm \
    /usr/local/bin/pnpx \
    /usr/local/bin/corepack \
    /usr/local/bin/yarn \
    /usr/local/bin/yarnpkg

# Create a non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy public directory for static assets
COPY --from=builder --chown=root:root /app/apps/frontend/public ./apps/frontend/public

# Copy the standalone output folder generated by Next.js
# The standalone build automatically traces files and only includes what's necessary
COPY --from=builder --chown=root:root /app/apps/frontend/.next/standalone ./
COPY --from=builder --chown=root:root /app/apps/frontend/.next/static ./apps/frontend/.next/static

# Keep executable code immutable to the runtime user; allow image/data cache writes only.
RUN mkdir -p /app/apps/frontend/.next/cache && chown nextjs:nodejs /app/apps/frontend/.next/cache

USER nextjs

EXPOSE 3000

# Next.js standalone server starts from the app directory
CMD ["node", "apps/frontend/server.js"]
