{
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": ".e2e-spec.ts$|integration/.*\\.spec\\.ts$",
    "transform": {
        "^.+\\.ts$": "@swc/jest"
    },
    "transformIgnorePatterns": [
        "/node_modules/",
        "/packages/database/client/"
    ],
    "moduleNameMapper": {
        "^@/(.*)$": "<rootDir>/../src/$1",
        "^@aluplan/database$": "<rootDir>/../../../packages/database"
    },
    "setupFiles": [
        "<rootDir>/setup.ts"
    ],
    "globalTeardown": "<rootDir>/global-teardown.ts",
    "maxWorkers": 1,
    "testTimeout": 60000
}
