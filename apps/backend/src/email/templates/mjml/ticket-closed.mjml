<mj-section padding="20px">
  <mj-column>
    <mj-text font-size="20px" font-weight="bold" color="#0f172a">Biletiniz Kapatıldı</mj-text>
    <mj-text>Merhaba <strong>{{customerName}}</strong>,</mj-text>
    <mj-text><strong>#{{ticketId}}</strong> bilet numaralı destek talebiniz başarıyla çözümlenmiş ve kapatılmıştır.</mj-text>
    <mj-button href="{{surveyUrl}}" padding-top="25px" align="center" font-weight="bold" border-radius="8px" css-class="btn-primary">Deneyiminizi Değerlendirin</mj-button>
  </mj-column>
</mj-section>
