<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, sans-serif" color="#334155" />
      <mj-text font-size="15px" line-height="1.6" />
    </mj-attributes>
    <mj-style inline="inline">
      .ticket-card { background-color: #f8fafc; border-left: 4px solid #0EA5E9; padding: 16px; margin: 16px 0; }
      .footer { border-top: 1px solid #e2e8f0; }
      .quote { font-style: italic; background-color: #f1f5f9; padding: 10px; border-left: 3px solid #cbd5e1; }
      .alert-red { background-color: #fef2f2; border-left: 4px solid #ef4444; padding: 16px; margin: 16px 0;}
    </mj-style>
  </mj-head>
  <mj-body background-color="#f1f5f9">
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <!-- Header -->
        <mj-text background-color="#0EA5E9" color="#fff" font-size="20px" font-weight="bold" padding="16px">
          {{brand.name}} Support
        </mj-text>

        <!-- Slot Content -->
        <mj-wrapper padding="10px 0">
           <!-- Dynamic Content Will Be Injected Here via Handlebars during build if needed or pure string parsing -->
        </mj-wrapper>

        <!-- Footer -->
        <mj-text css-class="footer" font-size="12px" color="#94a3b8" padding-top="20px">
          Bu otomatik bir mesajdır. <br/>
          <a href="{{brand.help_center_url}}" style="color:#0EA5E9;">Yardım Merkezi</a> | <a href="{{unsubscribe_url}}" style="color:#0EA5E9;">Abonelikten Çık</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
