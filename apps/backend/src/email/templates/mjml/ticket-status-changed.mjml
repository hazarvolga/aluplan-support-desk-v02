<mj-section padding="20px">
  <mj-column>
    <mj-text font-size="20px" font-weight="bold" color="#0f172a">Bilet Durumu Güncellendi</mj-text>
    <mj-text><strong>#{{ticketId}}</strong> numaralı biletinizin durumu değişti:</mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#f8fafc" padding="10px 0">
  <mj-column>
    <mj-text align="center"><span style="color: #64748b;">{{oldStatus}}</span> &rarr; <span style="font-weight: bold; color: #0EA5E9;">{{newStatus}}</span></mj-text>
  </mj-column>
</mj-section>

<mj-section padding="20px">
  <mj-column>
    <mj-button href="{{ticketUrl}}" align="center" font-weight="bold" border-radius="8px" css-class="btn-primary">Detayları Gör</mj-button>
  </mj-column>
</mj-section>
