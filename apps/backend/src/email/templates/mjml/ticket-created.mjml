<mj-section padding="20px">
  <mj-column>
    <mj-text font-size="22px" font-weight="bold" color="#0f172a">Talebiniz Alındı</mj-text>
    <mj-text>Merhaba <strong>{{customerName}}</strong>,</mj-text>
    <mj-text>Destek talebiniz başarıyla oluşturuldu. Ekibimiz en kısa sürede inceleyip size geri dönecektir.</mj-text>
    <mj-table padding-top="20px">
      <tr style="border-bottom:1px solid #ecedee;text-align:left;padding:15px 0;">
        <th style="padding: 10px 0;">Bilet Detayı</th>
        <th style="padding: 10px 0;">Değer</th>
      </tr>
      <tr><td style="padding: 10px 0;">Konu:</td><td style="padding: 10px 0;">{{ticketSubject}}</td></tr>
      <tr><td style="padding: 10px 0;">Öncelik:</td><td style="padding: 10px 0;">{{ticketPriority}}</td></tr>
      <tr><td style="padding: 10px 0;">Numara:</td><td style="padding: 10px 0;">#{{ticketId}}</td></tr>
    </mj-table>
    <mj-button href="{{ticketUrl}}" padding-top="30px" align="left" font-weight="bold" border-radius="8px" css-class="btn-primary">Bileti Görüntüle</mj-button>
  </mj-column>
</mj-section>
