<mj-section padding="20px">
  <mj-column>
    <mj-text font-size="20px" font-weight="bold" color="#0f172a">Biletinizde Yeni Bir Güncelleme Var</mj-text>
    <mj-text>Merhaba <strong>{{userName}}</strong>, <strong>#{{ticketId}}</strong> numaralı biletinizde yeni bir mesaj var:</mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#f1f5f9" border-radius="8px" padding="20px">
  <mj-column>
    <mj-text font-style="italic" color="#475569">"{{latestMessage}}"</mj-text>
  </mj-column>
</mj-section>

<mj-section padding="20px">
  <mj-column>
    <mj-button href="{{ticketUrl}}" align="left" font-weight="bold" border-radius="8px" css-class="btn-primary">Mesajı Cevapla</mj-button>
  </mj-column>
</mj-section>
