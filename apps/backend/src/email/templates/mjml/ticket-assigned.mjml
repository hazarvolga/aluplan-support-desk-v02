<mj-section padding="20px">
  <mj-column>
    <mj-text font-size="22px" font-weight="bold" color="#0f172a">Bilet Atandı</mj-text>
    <mj-text>Merhaba <strong>{{agentName}}</strong>, yeni bir destek bileti size atandı.</mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#f8fafc" border-radius="8px" padding="15px">
  <mj-column>
    <mj-text font-size="14px" color="#64748b" padding="0">Müşteri:</mj-text>
    <mj-text font-weight="bold" padding="0 0 10px 0">{{customerName}}</mj-text>
    <mj-text font-size="14px" color="#64748b" padding="0">Konu:</mj-text>
    <mj-text font-weight="bold" padding="0">{{ticketSubject}}</mj-text>
  </mj-column>
</mj-section>

<mj-section padding="20px">
  <mj-column>
    <mj-button href="{{ticketUrl}}" align="center" font-weight="bold" border-radius="8px" css-class="btn-primary">Bilete Git</mj-button>
  </mj-column>
</mj-section>
