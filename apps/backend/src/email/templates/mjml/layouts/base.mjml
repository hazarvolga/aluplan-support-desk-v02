<mjml>
  <mj-head>
    <mj-title>{{subject}}</mj-title>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" color="#334155" line-height="1.6" padding="10px 25px" />
      <mj-section background-color="#ffffff" padding="24px 0" />
      <mj-divider border-width="1px" border-color="#e2e8f0" border-style="solid" padding="24px 25px" />
      <mj-button background-color="{{brand.primary_color}}" color="#ffffff" font-size="14px" font-weight="700" border-radius="4px" padding="24px 25px" inner-padding="12px 24px" />
    </mj-attributes>
    <mj-style inline="inline">
      .body-text div { font-weight: 400 !important; }
      .header-title div { 
        font-size: 26px !important; 
        font-weight: 700 !important; 
        color: #0f172a !important; 
        line-height: 1.2 !important; 
        letter-spacing: -0.02em !important;
      }
      .technical-label div { 
        color: #64748b !important; 
        font-size: 12px !important; 
        text-transform: uppercase !important; 
        letter-spacing: 0.1em !important; 
        font-weight: 700 !important; 
      }
      .blueprint-card { 
        background-color: #ffffff !important; 
        border: 1px solid #e2e8f0 !important; 
        border-radius: 4px !important; 
      }
      .card-header {
        background-color: #f8fafc !important;
        border-bottom: 1px solid #e2e8f0 !important;
      }
    </mj-style>
    <mj-style>
      @media (prefers-color-scheme: dark) {
        .dark-mode-body { background-color: #020617 !important; }
        .dark-mode-section { background-color: #0f172a !important; }
        .dark-mode-text { color: #cbd5e1 !important; }
        .dark-mode-title { color: #f8fafc !important; }
        .dark-mode-card { background-color: #0f172a !important; border-color: #1e293b !important; }
        .dark-mode-card-header { background-color: #1e293b !important; border-bottom-color: #334155 !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8fafc" css-class="dark-mode-body">
    <!-- Header -->
    <mj-include path="../partials/header.mjml" />

    <!-- Space -->
    <mj-section padding="10px 0" background-color="transparent"></mj-section>

    <!-- Main Content Area -->
    <mj-wrapper padding="0 20px">
      {{{content}}}
    </mj-wrapper>

    <!-- Footer -->
    <mj-include path="../partials/footer.mjml" />
  </mj-body>
</mjml>
