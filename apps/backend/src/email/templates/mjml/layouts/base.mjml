<mjml>
  <mj-head>
    <mj-title>{{subject}}</mj-title>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" color="#334155" line-height="1.5" padding="10px 25px" />
      <mj-section background-color="#ffffff" padding="20px 0" />
      <mj-divider border-width="1px" border-color="#f1f5f9" border-style="solid" padding="20px 25px" />
      <mj-button background-color="{{brand.primary_color}}" color="#ffffff" font-size="14px" font-weight="600" border-radius="6px" padding="20px 25px" />
    </mj-attributes>
    <mj-style inline="inline">
      .body-text div { font-weight: 400 !important; }
      .header-title div { font-size: 24px !important; font-weight: 700 !important; color: #0f172a !important; line-height: 1.25 !important; }
      .info-label { color: #64748b !important; font-size: 13px !important; text-transform: uppercase !important; letter-spacing: 0.05em !important; font-weight: 600 !important; }
      .card-bg { background-color: #f8fafc !important; border: 1px solid #e2e8f0 !important; border-radius: 8px !important; }
    </mj-style>
    <mj-style>
      @media (prefers-color-scheme: dark) {
        .dark-mode-body { background-color: #0f172a !important; }
        .dark-mode-section { background-color: #1e293b !important; }
        .dark-mode-text { color: #f1f5f9 !important; }
        .dark-mode-title { color: #ffffff !important; }
        .dark-mode-card { background-color: #1e293b !important; border-color: #334155 !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8fafc" css-class="dark-mode-body">
    <!-- Header -->
    <mj-include path="../partials/header.mjml" />

    <!-- Space -->
    <mj-section padding="10px 0" background-color="transparent"></mj-section>

    <!-- Main Content Area -->
    <mj-wrapper padding="0 20px">
      {{{content}}}
    </mj-wrapper>

    <!-- Footer -->
    <mj-include path="../partials/footer.mjml" />
  </mj-body>
</mjml>
