<mjml>
  <mj-head>
    <mj-title>{{subject}}</mj-title>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif" color="#222222" />
      <mj-text font-size="14px" line-height="1.6" padding="10px 25px" />
      <mj-section background-color="#ffffff" padding="24px 0" />
      <mj-divider border-width="1px" border-color="#E0E0E0" border-style="solid" padding="15px 25px" />
      <mj-button background-color="{{#if brand.primary_color}}{{brand.primary_color}}{{else}}#0D47A1{{/if}}" color="#ffffff" font-size="14px" font-weight="600" border-radius="6px" padding="12px 25px" inner-padding="12px 30px" />
    </mj-attributes>
    <mj-style inline="inline">
      .body-text div { font-weight: 400 !important; }
      .header-title div { 
        font-size: 24px !important; 
        font-weight: 700 !important; 
        color: {{#if brand.primary_color}}{{brand.primary_color}}{{else}}#0D47A1{{/if}} !important; 
        line-height: 1.2 !important; 
        letter-spacing: -0.01em !important;
      }
      .ticket-card { border-left: 4px solid {{#if brand.primary_color}}{{brand.primary_color}}{{else}}#0D47A1{{/if}}; border-radius:8px; padding:15px; margin-bottom:15px; background-color: #ffffff; }
      .status-high { color:#D32F2F; font-weight:600; }
      .status-medium { color:#FBC02D; font-weight:600; }
      .status-low { color:#388E3C; font-weight:600; }
      .section-divider { border-top:1px solid #E0E0E0; margin:15px 0; }
      .technical-label div { 
        color: #64748b !important; 
        font-size: 12px !important; 
        text-transform: uppercase !important; 
        letter-spacing: 0.1em !important; 
        font-weight: 700 !important; 
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F4F4F4">
    <!-- Header -->
    <mj-include path="../partials/header.mjml" />

    <!-- Space -->
    <mj-section padding="10px 0" background-color="transparent"></mj-section>

    <!-- Main Content Area -->
    <mj-wrapper padding="0 20px">
      {{{content}}}
    </mj-wrapper>

    <!-- Footer -->
    <mj-include path="../partials/footer.mjml" />
  </mj-body>
</mjml>
