<mj-section padding="20px">
  <mj-column>
    <mj-text font-size="22px" font-weight="bold" color="#0f172a" align="center">Deneyiminizi Değerlendirin</mj-text>
    <mj-text align="center">Biletiniz (#{{ticketId}}) çözümlendi olarak işaretlendi. Size verdiğimiz hizmeti değerlendirir misiniz?</mj-text>
  </mj-column>
</mj-section>

<mj-section padding="20px 0" background-color="#ffffff">
  <mj-column width="33%">
    <mj-button href="{{surveyUrl}}?rating=GOOD" background-color="#22c55e" border-radius="50px" width="60px" height="60px">😊</mj-button>
    <mj-text align="center" font-size="12px">İyi</mj-text>
  </mj-column>
  <mj-column width="33%">
    <mj-button href="{{surveyUrl}}?rating=NEUTRAL" background-color="#eab308" border-radius="50px" width="60px" height="60px">😐</mj-button>
    <mj-text align="center" font-size="12px">Orta</mj-text>
  </mj-column>
  <mj-column width="33%">
    <mj-button href="{{surveyUrl}}?rating=BAD" background-color="#ef4444" border-radius="50px" width="60px" height="60px">☹️</mj-button>
    <mj-text align="center" font-size="12px">Kötü</mj-text>
  </mj-column>
</mj-section>
