<!-- Header & Intro -->
<mj-section css-class="dark-mode-section" padding="32px 24px 16px 24px">
  <mj-column>
    <mj-text css-class="header-title dark-mode-title" padding="0 0 12px 0">{{t.ticket_created.title}}</mj-text>
    <mj-text css-class="body-text dark-mode-text" padding="0">
      {{t.common.hello}} <strong>{{customerName}}</strong>,<br /><br />
      {{t.ticket_created.description}}
    </mj-text>
  </mj-column>
</mj-section>

<!-- Technical Detail Card -->
<mj-section css-class="blueprint-card dark-mode-card" padding="0">
  <mj-column>
    <mj-text css-class="card-header dark-mode-card-header technical-label" padding="12px 20px">
      {{t.common.subject}}
    </mj-text>
    <mj-text font-weight="600" font-size="16px" css-class="dark-mode-text" padding="16px 20px">
      {{ticketSubject}}
    </mj-text>
    <mj-divider border-width="1px" border-color="#e2e8f0" padding="0" />
    <mj-text css-class="technical-label" padding="16px 20px 4px 20px">
      {{t.common.priority}}
    </mj-text>
    <mj-text font-weight="600" css-class="dark-mode-text" padding="0 20px 16px 20px">
      {{ticketPriority}}
    </mj-text>
    <mj-text css-class="technical-label" padding="0 20px 4px 20px">
      {{t.common.ticket_id}}
    </mj-text>
    <mj-text font-weight="700" color="{{brand.primary_color}}" padding="0 20px 20px 20px">
      #{{ticketId}}
    </mj-text>
  </mj-column>
</mj-section>

<!-- Action -->
<mj-section css-class="dark-mode-section" padding="24px 0 40px 0">
  <mj-column>
    <mj-button href="{{ticketUrl}}" align="center">
      {{t.common.view_ticket}}
    </mj-button>
  </mj-column>
</mj-section>
