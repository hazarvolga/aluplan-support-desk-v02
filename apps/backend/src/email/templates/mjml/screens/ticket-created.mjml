<!-- Top Section: Header & Intro -->
<mj-section background-color="#ffffff" border-radius="12px 12px 0 0" css-class="dark-mode-section" padding-bottom="0">
  <mj-column>
    <mj-text css-class="header-title dark-mode-title">{{t.ticket_created.title}}</mj-text>
    <mj-text css-class="body-text dark-mode-text">
      {{t.common.hello}} <strong>{{customerName}}</strong>,
    </mj-text>
    <mj-text css-class="body-text dark-mode-text">
      {{t.ticket_created.description}}
    </mj-text>
  </mj-column>
</mj-section>

<!-- Card Section: Details -->
<mj-section background-color="#f8fafc" border="1px solid #e2e8f0" border-radius="8px" css-class="dark-mode-card" padding="20px">
  <mj-column>
    <mj-text padding="0 0 5px 0" css-class="info-label">{{t.common.subject}}</mj-text>
    <mj-text padding="0 0 15px 0" font-weight="600" css-class="dark-mode-text">{{ticketSubject}}</mj-text>
    
    <mj-text padding="0 0 5px 0" css-class="info-label">{{t.common.priority}}</mj-text>
    <mj-text padding="0 0 15px 0" font-weight="600" css-class="dark-mode-text">{{ticketPriority}}</mj-text>
    
    <mj-text padding="0 0 5px 0" css-class="info-label">{{t.common.ticket_id}}</mj-text>
    <mj-text padding="0" font-weight="600" color="#0EA5E9">#{{ticketId}}</mj-text>
  </mj-column>
</mj-section>

<!-- Bottom Section: CTA -->
<mj-section background-color="#ffffff" border-radius="0 0 12px 12px" css-class="dark-mode-section">
  <mj-column>
    <mj-button href="{{ticketUrl}}" align="left">
      {{t.common.view_ticket}}
    </mj-button>
  </mj-column>
</mj-section>
