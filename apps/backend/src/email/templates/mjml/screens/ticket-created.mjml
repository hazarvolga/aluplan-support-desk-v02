<!-- Header & Intro -->
<mj-section background-color="#FFFFFF" padding="25px 20px">
  <mj-column>
    <mj-text font-size="22px" font-weight="700" color="{{#if brand.primary_color}}{{brand.primary_color}}{{else}}#0D47A1{{/if}}" align="center">
      {{t.ticket_created.title}}
    </mj-text>
    <mj-text font-size="16px" color="#555555" align="center">
      {{t.ticket_created.description}}
    </mj-text>
  </mj-column>
</mj-section>

<!-- Ticket Highlights -->
<mj-section background-color="#FFFFFF" padding="20px 20px">
  <mj-column>
    <mj-text font-size="16px" font-weight="600" color="{{#if brand.primary_color}}{{brand.primary_color}}{{else}}#0D47A1{{/if}}">
      {{t.common.ticket_id}} #{{ticketId}} – {{ticketSubject}}
    </mj-text>
    <mj-text>
      {{t.common.hello}} <strong>{{customerName}}</strong>,<br/>
      {{t.ticket_created.description_short}}
    </mj-text>

    <mj-text css-class="ticket-card">
      • {{t.common.priority}}: <span class="status-{{ticketPriorityLow}}">{{ticketPriority}}</span><br/>
      • {{t.common.status}}: <strong>{{ticketStatus}}</strong><br/>
      • {{t.common.created_at}}: {{createdAt}}
    </mj-text>

    {{#if ticketCategory}}
    <mj-text css-class="ticket-card">
      • {{t.common.category}}: <strong>{{ticketCategory}}</strong><br/>
      • {{t.common.type}}: <strong>{{ticketType}}</strong>
    </mj-text>
    {{/if}}
  </mj-column>
</mj-section>

<!-- Action Buttons -->
<mj-section background-color="#FFFFFF" padding="15px 20px">
  <mj-column width="100%">
    <mj-button href="{{ticketUrl}}">
      {{t.common.view_ticket}}
    </mj-button>
  </mj-column>
</mj-section>
