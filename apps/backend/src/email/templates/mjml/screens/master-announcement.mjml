<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Inter, system-ui, sans-serif" />
      <mj-text line-height="1.6" color="#334155" font-size="15px" />
    </mj-attributes>
    <mj-style>
      .brand-header { padding-bottom: 20px; }
      .content-wrapper { background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); }
      .footer-text { font-size: 12px; color: #94a3b8; text-align: center; }
      
      /* TipTap HTML Injection Styles */
      .rich-text h1 { font-size: 24px; color: #0f172a; font-weight: 700; margin-top: 0; margin-bottom: 16px; }
      .rich-text h2 { font-size: 20px; color: #1e293b; font-weight: 600; margin-top: 24px; margin-bottom: 12px; }
      .rich-text p { margin-top: 0; margin-bottom: 16px; }
      .rich-text ul, .rich-text ol { margin-top: 0; margin-bottom: 16px; padding-left: 24px; }
      .rich-text li { margin-bottom: 8px; }
      .rich-text a { color: #2563eb; text-decoration: underline; }
      .rich-text img { max-width: 100%; height: auto; border-radius: 8px; margin: 16px 0; }
      .rich-text hr { border: 0; border-top: 1px solid #e2e8f0; margin: 24px 0; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8fafc">
    
    <!-- Branding Header (Shared Partials) -->
    <mj-include path="../partials/header.mjml" />
    
    <!-- Announcement Content Area -->
    {{{contentHtml}}}

    <!-- Optional CTA Button injected if provided -->
    {{#if ctaUrl}}
    <mj-section padding-top="0px">
      <mj-column>
        <mj-button href="{{ctaUrl}}" background-color="#0ea5e9" color="white" border-radius="6px" font-weight="600">
          {{ctaText}}
        </mj-button>
      </mj-column>
    </mj-section>
    {{/if}}

    <!-- Footer Information (Shared Partials) -->
    <mj-include path="../partials/footer.mjml" />

  </mj-body>
</mjml>
