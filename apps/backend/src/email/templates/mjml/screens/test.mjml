<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" color="#222222" />
      <mj-text font-size="14px" line-height="1.6" />
      <mj-button background-color="#0D47A1" color="#ffffff" border-radius="6px" font-weight="600" padding="12px 30px" />
    </mj-attributes>
    <mj-style inline="inline">
      .ticket-card { border-left: 4px solid #0D47A1; border-radius:8px; padding:15px; margin-bottom:15px; }
      .status-high { color:#D32F2F; font-weight:600; }
      .status-medium { color:#FBC02D; font-weight:600; }
      .status-low { color:#388E3C; font-weight:600; }
      .section-divider { border-top:1px solid #E0E0E0; margin:15px 0; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F4F4F4">

    <!-- Header -->
    <mj-section background-color="#FFFFFF" padding="25px 20px">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#0D47A1" align="center">
          Engineering Support Notification
        </mj-text>
        <mj-text font-size="16px" color="#555555" align="center">
          Sophisticated updates tailored for professionals
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Ticket Highlights -->
    <mj-section background-color="#FFFFFF" padding="20px 20px">
      <mj-column>
        <mj-text font-size="16px" font-weight="600" color="#0D47A1">
          Ticket #98765 – Structural Analysis Inquiry
        </mj-text>
        <mj-text>
          Hello <strong>Alex Johnson</strong>,<br/>
          Your ticket regarding <em>3D model optimization</em> has been updated by our engineering team. Key points:
        </mj-text>

        <mj-text css-class="ticket-card">
          • Assigned Agent: <strong>Sarah Lee</strong><br/>
          • Status: <span class="status-high">High Priority</span><br/>
          • Next Update: 24 hours
        </mj-text>

        <mj-text css-class="ticket-card">
          • Project Phase: Design Review<br/>
          • Complexity Level: Advanced<br/>
          • Notes: Review structural load distribution
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Action Buttons -->
    <mj-section background-color="#FFFFFF" padding="15px 20px">
      <mj-column width="50%">
        <mj-button href="https://support.yoursite.com/tickets/98765">
          View Ticket
        </mj-button>
      </mj-column>
      <mj-column width="50%">
        <mj-button background-color="#455A64" href="https://support.yoursite.com/help-center">
          Help Center
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Visual Divider -->
    <mj-section padding="10px 20px">
      <mj-column>
        <mj-text css-class="section-divider"></mj-text>
      </mj-column>
    </mj-section>

    <!-- Key Notes / Micro Details -->
    <mj-section background-color="#E3F2FD" padding="15px 20px" border-radius="8px">
      <mj-column>
        <mj-text font-size="13px" color="#0D47A1">
          • Engineering updates are precise and validated<br/>
          • All calculations verified against project standards<br/>
          • Recommended next steps attached in your ticket
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#FFFFFF" padding="20px 0">
      <mj-column>
        <mj-text font-size="10px" color="#888888" align="center" line-height="1.3">
          Developed by <strong>AffeXAI</strong> | <a href="https://www.yoursite.com" style="color:#888888; text-decoration:none;">www.yoursite.com</a> | contact@yoursite.com
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>