<mj-section background-color="#ffffff" border-radius="12px" css-class="dark-mode-section">
  <mj-column>
    <mj-text css-class="header-title dark-mode-title" align="center">{{t.common.rate_experience}}</mj-text>
    <mj-text align="center" css-class="body-text dark-mode-text">
      Biletiniz (#{{ticketId}}) çözümlendi. Size verdiğimiz hizmeti değerlendirir misiniz?
    </mj-text>
    
    <mj-section padding="20px 0" background-color="transparent">
      <mj-column width="33%">
        <mj-button href="{{surveyUrl}}?rating=GOOD" background-color="#22c55e" border-radius="50px" width="60px" height="60px">😊</mj-button>
        <mj-text align="center" font-size="12px" color="#64748b">İyi</mj-text>
      </mj-column>
      <mj-column width="33%">
        <mj-button href="{{surveyUrl}}?rating=NEUTRAL" background-color="#eab308" border-radius="50px" width="60px" height="60px">😐</mj-button>
        <mj-text align="center" font-size="12px" color="#64748b">Orta</mj-text>
      </mj-column>
      <mj-column width="33%">
        <mj-button href="{{surveyUrl}}?rating=BAD" background-color="#ef4444" border-radius="50px" width="60px" height="60px">☹️</mj-button>
        <mj-text align="center" font-size="12px" color="#64748b">Kötü</mj-text>
      </mj-column>
    </mj-section>
  </mj-column>
</mj-section>
