<!-- Header & Survey Intro -->
<mj-section background-color="#FFFFFF" padding="25px 20px">
  <mj-column>
    <mj-text font-size="22px" font-weight="700" color="{{#if brand.primary_color}}{{brand.primary_color}}{{else}}#0D47A1{{/if}}" align="center">
      {{t.common.rate_experience}}
    </mj-text>
    <mj-text font-size="16px" color="#555555" align="center">
      <strong>#{{ticketId}}</strong> {{t.ticket_closed.description}}
    </mj-text>
  </mj-column>
</mj-section>

<!-- Action Buttons -->
<mj-section background-color="#FFFFFF" padding="15px 20px">
  <mj-column width="100%">
    <mj-button href="{{surveyUrl}}">
      {{t.common.submit_feedback}}
    </mj-button>
    <mj-text align="center" font-size="13px" color="#94a3b8" padding-top="16px">
      {{t.common.feedback_footer}}
    </mj-text>
  </mj-column>
</mj-section>
