<mj-section css-class="dark-mode-section" padding="40px 24px 24px 24px">
  <mj-column>
    <mj-text css-class="header-title dark-mode-title" align="center" padding="0 0 16px 0">{{t.csat.title}}</mj-text>
    <mj-text css-class="body-text dark-mode-text" align="center" padding="0">
      <strong>#{{ticketId}}</strong> {{t.csat.description}}
    </mj-text>
  </mj-column>
</mj-section>

<mj-section css-class="dark-mode-section" padding="0 0 40px 0">
  <mj-column>
    <mj-button href="{{surveyUrl}}" align="center">
       Deneyiminizi Puanlayın
    </mj-button>
    <mj-text align="center" font-size="13px" color="#94a3b8" padding-top="16px">
      {{t.csat.footer_note}}
    </mj-text>
  </mj-column>
</mj-section>
