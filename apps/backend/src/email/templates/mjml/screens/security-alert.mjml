<mj-section css-class="dark-mode-section" padding="32px 24px 16px 24px" border-top="4px solid #ef4444">
  <mj-column>
    <mj-text css-class="header-title" color="#ef4444 !important" padding="0 0 12px 0">{{t.security.new_login_title}}</mj-text>
    <mj-text css-class="body-text dark-mode-text" padding="0">{{t.security.new_login_desc}}</mj-text>
  </mj-column>
</mj-section>

<mj-section css-class="blueprint-card dark-mode-card" padding="0" border-left="4px solid #ef4444">
  <mj-column>
    <mj-text css-class="card-header dark-mode-card-header technical-label" padding="12px 20px">
      {{t.common.date}}
    </mj-text>
    <mj-text font-weight="600" css-class="dark-mode-text" padding="12px 20px">
      {{loginDate}}
    </mj-text>
    <mj-divider border-width="1px" border-color="#e2e8f0" padding="0" />
    <mj-text css-class="technical-label" padding="12px 20px 4px 20px">
      {{t.common.device}}
    </mj-text>
    <mj-text font-weight="600" css-class="dark-mode-text" padding="0 20px 12px 20px">
      {{deviceInfo}}
    </mj-text>
    <mj-text css-class="technical-label" padding="0 20px 4px 20px">
      {{t.common.location}}
    </mj-text>
    <mj-text font-weight="600" css-class="dark-mode-text" padding="0 20px 16px 20px">
      {{locationInfo}}
    </mj-text>
  </mj-column>
</mj-section>

<mj-section css-class="dark-mode-section" padding="24px 0 40px 0">
  <mj-column>
    <mj-button href="{{securityUrl}}" background-color="#ef4444" align="center">
      {{t.security.not_me}}
    </mj-button>
  </mj-column>
</mj-section>
