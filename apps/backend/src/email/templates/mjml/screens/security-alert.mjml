<mj-section background-color="#ffffff" border-radius="12px 12px 0 0" border="2px solid #ef4444" border-bottom="0" css-class="dark-mode-section">
  <mj-column>
    <mj-text css-class="header-title" color="#ef4444 !important">{{t.security.new_login_title}}</mj-text>
    <mj-text css-class="body-text dark-mode-text">
      {{t.security.new_login_desc}}
    </mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#f8fafc" border-radius="0" border-left="2px solid #ef4444" border-right="2px solid #ef4444" css-class="dark-mode-card" padding="15px">
  <mj-column>
    <mj-text padding="0 0 5px 0" css-class="info-label">{{t.common.date}}</mj-text>
    <mj-text padding="0 0 10px 0" font-weight="600" css-class="dark-mode-text">{{loginDate}}</mj-text>
    
    <mj-text padding="0 0 5px 0" css-class="info-label">{{t.common.device}}</mj-text>
    <mj-text padding="0 0 10px 0" font-weight="600" css-class="dark-mode-text">{{deviceInfo}}</mj-text>
    
    <mj-text padding="0 0 5px 0" css-class="info-label">{{t.common.location}}</mj-text>
    <mj-text padding="0" font-weight="600" css-class="dark-mode-text">{{locationInfo}}</mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#ffffff" border-radius="0 0 12px 12px" border="2px solid #ef4444" border-top="0" css-class="dark-mode-section">
  <mj-column>
    <mj-button href="{{securityUrl}}" background-color="#ef4444">
      {{t.security.not_me}}
    </mj-button>
  </mj-column>
</mj-section>
