<!-- Header & Alert Intro -->
<mj-section background-color="#FFFFFF" padding="25px 20px" border-top="4px solid #D32F2F">
  <mj-column>
    <mj-text font-size="22px" font-weight="700" color="#D32F2F" align="center">
      {{t.security.new_login_title}}
    </mj-text>
    <mj-text font-size="16px" color="#555555" align="center">
      {{t.security.new_login_desc}}
    </mj-text>
  </mj-column>
</mj-section>

<!-- Login Details -->
<mj-section background-color="#FFFFFF" padding="20px 20px">
  <mj-column>
    <mj-text css-class="ticket-card" border-left="4px solid #D32F2F">
      • {{t.common.date}}: <strong>{{loginDate}}</strong><br/>
      • {{t.common.device}}: <strong>{{deviceInfo}}</strong><br/>
      • {{t.common.location}}: <strong>{{locationInfo}}</strong>
    </mj-text>
  </mj-column>
</mj-section>

<!-- Action Buttons -->
<mj-section background-color="#FFFFFF" padding="15px 20px">
  <mj-column width="100%">
    <mj-button href="{{securityUrl}}" background-color="#D32F2F">
      {{t.security.not_me}}
    </mj-button>
  </mj-column>
</mj-section>
