<mj-section background-color="#FFFFFF" padding="25px 20px">
  <mj-column>
    <mj-text font-size="22px" font-weight="700" color="{{#if brand.primary_color}}{{brand.primary_color}}{{else}}#0D47A1{{/if}}" align="center">
      Aluplan Destek Ekosistemine Hoş Geldiniz!
    </mj-text>
    <mj-text font-size="16px" color="#555555" align="left" line-height="1.5">
      Sayın {{customerName}},<br/><br/>
      Aluplan Destek Ekosistemine Hoş Geldiniz! Kayıt işleminiz başarıyla başlatıldı.<br/><br/>
      Hesabınızı aktif hale getirmek ve giriş yapabilmek için lütfen aşağıdaki butona tıklayarak e-posta adresinizi doğrulayın:<br/><br/>
    </mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#FFFFFF" padding="0px 20px 20px 20px">
  <mj-column width="100%">
    <mj-button href="{{verifyUrl}}" background-color="{{#if brand.primary_color}}{{brand.primary_color}}{{else}}#0D47A1{{/if}}" color="white" font-weight="bold" border-radius="8px" inner-padding="15px 30px">
      E-postayı Doğrula
    </mj-button>
  </mj-column>
</mj-section>

<mj-section background-color="#FFFFFF" padding="0px 20px 25px 20px">
  <mj-column>
    <mj-text font-size="14px" color="#7d7d7d" line-height="1.4">
      Doğrulama işleminden sonra aşağıdaki bilgilerle giriş yapabilirsiniz:<br/><br/>
      <b>E-posta:</b> {{email}}<br/>
      <b>Geçici Şifre:</b> {{password}}<br/><br/>
      <i>Güvenliğiniz için sisteme giriş yaptıktan sonra şifrenizi değiştirmenizi öneririz.</i>
    </mj-text>
  </mj-column>
</mj-section>
