<mj-section css-class="dark-mode-section" padding="32px 24px 16px 24px" border-top="4px solid #ef4444">
  <mj-column>
    <mj-text css-class="header-title" color="#b91c1c !important" padding="0 0 12px 0">{{t.sla.breached_title}}</mj-text>
    <mj-text css-class="body-text dark-mode-text" padding="0">{{t.sla.breached_desc}}</mj-text>
  </mj-column>
</mj-section>

<mj-section css-class="blueprint-card dark-mode-card" padding="0" border-left="4px solid #ef4444">
  <mj-column>
    <mj-text css-class="technical-label" padding="16px 20px 4px 20px">
       {{t.common.ticket_id}}
    </mj-text>
    <mj-text font-weight="600" css-class="dark-mode-text" padding="0 20px 12px 20px">
      #{{ticketId}} - {{ticketSubject}}
    </mj-text>
    <mj-divider border-width="1px" border-color="#e2e8f0" padding="0" />
    <mj-text css-class="technical-label" padding="12px 20px 4px 20px">
      {{t.common.agent}}
    </mj-text>
    <mj-text font-weight="700" color="#b91c1c" padding="0 20px 16px 20px">
      {{agentName}}
    </mj-text>
  </mj-column>
</mj-section>

<mj-section css-class="dark-mode-section" padding="24px 0 40px 0">
  <mj-column>
    <mj-button href="{{ticketUrl}}" background-color="#ef4444" align="center">
      Acil Müdahale Et
    </mj-button>
  </mj-column>
</mj-section>
