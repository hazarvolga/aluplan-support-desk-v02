<!-- Header & Urgency Intro -->
<mj-section background-color="#FFFFFF" padding="25px 20px" border-top="4px solid #D32F2F">
  <mj-column>
    <mj-text font-size="22px" font-weight="700" color="#D32F2F" align="center">
      {{t.sla.breached_title}}
    </mj-text>
    <mj-text font-size="16px" color="#555555" align="center">
      {{t.sla.breached_desc}}
    </mj-text>
  </mj-column>
</mj-section>

<!-- Ticket Details -->
<mj-section background-color="#FFFFFF" padding="20px 20px">
  <mj-column>
    <mj-text font-size="16px" font-weight="600" color="#D32F2F">
      {{t.common.ticket_id}} #{{ticketId}} – {{ticketSubject}}
    </mj-text>
    <mj-text css-class="ticket-card" border-left="4px solid #D32F2F">
      • {{t.common.agent}}: <strong>{{agentName}}</strong><br/>
      • {{t.common.sla_status}}: <span class="status-high">{{t.sla.breached}}</span>
    </mj-text>
  </mj-column>
</mj-section>

<!-- Action Buttons -->
<mj-section background-color="#FFFFFF" padding="15px 20px">
  <mj-column width="100%">
    <mj-button href="{{ticketUrl}}" background-color="#D32F2F">
      {{t.sla.take_action}}
    </mj-button>
  </mj-column>
</mj-section>
