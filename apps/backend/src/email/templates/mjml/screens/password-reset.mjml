<mj-section css-class="dark-mode-section" padding="40px 24px 24px 24px">
  <mj-column>
    <mj-text css-class="header-title dark-mode-title" padding="0 0 16px 0">{{t.password_reset.title}}</mj-text>
    <mj-text css-class="body-text dark-mode-text" padding="0 0 24px 0">
       {{t.common.hello}},<br /><br />
      {{t.password_reset.description}}
    </mj-text>
    <mj-button href="{{resetUrl}}" align="left">
      {{t.common.reset_password}}
    </mj-button>
    <mj-text font-size="13px" color="#94a3b8" padding-top="24px">
      {{t.password_reset.footer_note}}
    </mj-text>
  </mj-column>
</mj-section>
