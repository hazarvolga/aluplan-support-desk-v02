<!-- Header & Reset Intro -->
<mj-section background-color="#FFFFFF" padding="25px 20px">
  <mj-column>
    <mj-text font-size="22px" font-weight="700" color="{{#if brand.primary_color}}{{brand.primary_color}}{{else}}#0D47A1{{/if}}" align="center">
      {{t.account.pw_reset_title}}
    </mj-text>
    <mj-text font-size="16px" color="#555555" align="center">
      {{t.common.hello}},<br/>
      {{t.account.pw_reset_desc}}
    </mj-text>
  </mj-column>
</mj-section>

<!-- Action Buttons -->
<mj-section background-color="#FFFFFF" padding="15px 20px">
  <mj-column width="100%">
    <mj-button href="{{resetUrl}}">
      {{t.common.reset_password}}
    </mj-button>
    <mj-divider border-width="1px" border-color="#E0E0E0" />
    <mj-text align="center" font-size="12px" color="#94a3b8" padding-top="16px">
      {{t.account.pw_reset_notice}}
    </mj-text>
  </mj-column>
</mj-section>
