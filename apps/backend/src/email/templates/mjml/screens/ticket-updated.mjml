<!-- Header & Intro -->
<mj-section background-color="#FFFFFF" padding="25px 20px">
  <mj-column>
    <mj-text font-size="22px" font-weight="700" color="{{#if brand.primary_color}}{{brand.primary_color}}{{else}}#0D47A1{{/if}}" align="center">
      {{t.ticket_updated.title}}
    </mj-text>
    <mj-text font-size="16px" color="#555555" align="center">
      {{t.common.hello}} <strong>{{userName}}</strong>,<br/>
      <strong>#{{ticketId}}</strong> {{t.ticket_updated.description}}
    </mj-text>
  </mj-column>
</mj-section>

<!-- Latest Message Detail -->
<mj-section background-color="#FFFFFF" padding="20px 20px">
  <mj-column>
    <mj-text font-size="16px" font-weight="600" color="{{#if brand.primary_color}}{{brand.primary_color}}{{else}}#0D47A1{{/if}}">
      {{t.ticket_updated.latest_message_summary}}
    </mj-text>
    <mj-text css-class="ticket-card" font-style="italic">
      "{{latestMessage}}"
    </mj-text>
  </mj-column>
</mj-section>

<!-- Action Buttons -->
<mj-section background-color="#FFFFFF" padding="15px 20px">
  <mj-column width="100%">
    <mj-button href="{{ticketUrl}}">
      {{t.common.view_ticket}}
    </mj-button>
  </mj-column>
</mj-section>
