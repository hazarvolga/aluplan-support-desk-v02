<mj-section background-color="#ffffff" border-radius="12px 12px 0 0" css-class="dark-mode-section">
  <mj-column>
    <mj-text css-class="header-title dark-mode-title">{{t.ticket_updated.title}}</mj-text>
    <mj-text css-class="body-text dark-mode-text">
       {{t.common.hello}} <strong>{{userName}}</strong>,
    </mj-text>
    <mj-text css-class="body-text dark-mode-text">
       <strong>#{{ticketId}}</strong> {{t.ticket_updated.description}}
    </mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#f8fafc" border-radius="8px" padding="20px" css-class="dark-mode-card">
  <mj-column>
    <mj-text font-style="italic" color="#475569" css-class="dark-mode-text" padding="0">"{{latestMessage}}"</mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#ffffff" border-radius="0 0 12px 12px" css-class="dark-mode-section">
  <mj-column>
    <mj-button href="{{ticketUrl}}" align="left">
      {{t.common.view_ticket}}
    </mj-button>
  </mj-column>
</mj-section>
