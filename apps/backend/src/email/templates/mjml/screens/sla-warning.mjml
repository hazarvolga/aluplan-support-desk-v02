<!-- Header & Warning Intro -->
<mj-section background-color="#FFFFFF" padding="25px 20px" border-top="4px solid #FBC02D">
  <mj-column>
    <mj-text font-size="22px" font-weight="700" color="#FBC02D" align="center">
      {{t.sla.warning_title}}
    </mj-text>
    <mj-text font-size="16px" color="#555555" align="center">
      {{t.sla.warning_desc}}
    </mj-text>
  </mj-column>
</mj-section>

<!-- Ticket Highlights -->
<mj-section background-color="#FFFFFF" padding="20px 20px">
  <mj-column>
    <mj-text font-size="16px" font-weight="600" color="#FBC02D">
      {{t.common.ticket_id}} #{{ticketId}} – {{ticketSubject}}
    </mj-text>
    <mj-text css-class="ticket-card" border-left="4px solid #FBC02D">
      • {{t.common.time_remaining}}: <strong>{{minutesLeft}} {{t.common.minutes}}</strong><br/>
      • {{t.common.status}}: <strong>{{ticketStatus}}</strong>
    </mj-text>
  </mj-column>
</mj-section>

<!-- Action Buttons -->
<mj-section background-color="#FFFFFF" padding="15px 20px">
  <mj-column width="100%">
    <mj-button href="{{ticketUrl}}" background-color="#FBC02D">
      {{t.common.go_to_ticket}}
    </mj-button>
  </mj-column>
</mj-section>
