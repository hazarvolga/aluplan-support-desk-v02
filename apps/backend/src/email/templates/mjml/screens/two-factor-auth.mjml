<!-- Header & 2FA Intro -->
<mj-section background-color="#FFFFFF" padding="25px 20px">
  <mj-column>
    <mj-text font-size="22px" font-weight="700" color="{{#if brand.primary_color}}{{brand.primary_color}}{{else}}#0D47A1{{/if}}" align="center">
      {{t.security.2fa_title}}
    </mj-text>
    <mj-text font-size="16px" color="#555555" align="center">
      {{t.security.2fa_desc}}
    </mj-text>
  </mj-column>
</mj-section>

<!-- Token Card -->
<mj-section background-color="#FFFFFF" padding="20px 20px">
  <mj-column>
    <mj-text css-class="ticket-card" align="center" font-size="32px" font-weight="700" letter-spacing="0.2em" color="{{#if brand.primary_color}}{{brand.primary_color}}{{else}}#0D47A1{{/if}}">
      {{token}}
    </mj-text>
    <mj-text font-size="12px" color="#94a3b8" padding-top="20px" align="center">
      {{t.security.2fa_expire}}
    </mj-text>
  </mj-column>
</mj-section>
