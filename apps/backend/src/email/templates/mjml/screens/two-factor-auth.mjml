<mj-section css-class="dark-mode-section" padding="40px 24px 24px 24px">
  <mj-column>
    <mj-text css-class="header-title dark-mode-title" padding="0 0 16px 0">{{t.security.two_factor_title}}</mj-text>
    <mj-text css-class="body-text dark-mode-text" padding="0 0 32px 0">
      {{t.security.two_factor_desc}}
    </mj-text>
    
    <mj-section css-class="blueprint-card dark-mode-card" padding="24px">
      <mj-column>
        <mj-text align="center" font-size="32px" font-weight="700" letter-spacing="0.2em" color="{{brand.primary_color}}" padding="0">
          {{token}}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-text font-size="13px" color="#94a3b8" padding-top="32px" align="center">
      Bu kod 10 dakika geçerlidir.
    </mj-text>
  </mj-column>
</mj-section>
