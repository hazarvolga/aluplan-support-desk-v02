<mj-section background-color="#ffffff" border-radius="12px 12px 0 0" css-class="dark-mode-section">
  <mj-column>
    <mj-text css-class="header-title dark-mode-title">{{t.ticket_status.title}}</mj-text>
    <mj-text css-class="body-text dark-mode-text">
      <strong>#{{ticketId}}</strong> {{t.ticket_status.changed_to}}
    </mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#f8fafc" border-radius="8px" padding="20px" css-class="dark-mode-card">
  <mj-column>
    <mj-text align="center" font-size="20px">
      <span style="color: #64748b;">{{oldStatus}}</span>
      <span style="color: #94a3b8; padding: 0 10px;">&rarr;</span>
      <span style="font-weight: 700; color: #0EA5E9;">{{newStatus}}</span>
    </mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="#ffffff" border-radius="0 0 12px 12px" css-class="dark-mode-section">
  <mj-column>
    <mj-button href="{{ticketUrl}}" align="center">
      {{t.common.view_ticket}}
    </mj-button>
  </mj-column>
</mj-section>
