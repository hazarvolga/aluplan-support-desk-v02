<mj-section css-class="dark-mode-section" padding="32px 24px 16px 24px">
  <mj-column>
    <mj-text css-class="header-title dark-mode-title" padding="0 0 8px 0">{{t.ticket_status.title}}</mj-text>
    <mj-text css-class="body-text dark-mode-text" padding="0">
      <strong>#{{ticketId}}</strong> {{t.ticket_status.changed_to}}
    </mj-text>
  </mj-column>
</mj-section>

<mj-section css-class="blueprint-card dark-mode-card" padding="24px">
  <mj-column>
    <mj-text align="center" padding="0">
      <span style="color: #94a3b8; font-size: 12px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.1em; display: block; margin-bottom: 8px;">Mevcut Durum</span>
      <span style="font-size: 20px; font-weight: 600; color: #64748b;">{{oldStatus}}</span>
      <span style="color: #cbd5e1; padding: 0 16px; font-size: 24px; vertical-align: middle;">&rarr;</span>
      <span style="font-size: 20px; font-weight: 700; color: {{brand.primary_color}};">{{newStatus}}</span>
    </mj-text>
  </mj-column>
</mj-section>

<mj-section css-class="dark-mode-section" padding="24px 0 40px 0">
  <mj-column>
    <mj-button href="{{ticketUrl}}" align="center">
      {{t.common.view_ticket}}
    </mj-button>
  </mj-column>
</mj-section>
