<!-- Header & Intro -->
<mj-section background-color="#FFFFFF" padding="25px 20px">
  <mj-column>
    <mj-text font-size="22px" font-weight="700" color="{{#if brand.primary_color}}{{brand.primary_color}}{{else}}#0D47A1{{/if}}" align="center">
      {{t.ticket_status.title}}
    </mj-text>
    <mj-text font-size="16px" color="#555555" align="center">
      <strong>#{{ticketId}}</strong> {{t.ticket_status.changed_to}}
    </mj-text>
  </mj-column>
</mj-section>

<!-- Status Transition Card -->
<mj-section background-color="#FFFFFF" padding="20px 20px">
  <mj-column>
    <mj-text css-class="ticket-card" align="center">
      <span style="color: #64748b; font-size: 12px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.1em; display: block; margin-bottom: 8px;">{{t.common.old_status}}</span>
      <span style="font-size: 18px; font-weight: 600; color: #64748b;">{{oldStatus}}</span>
      <span style="color: #cbd5e1; padding: 0 16px; font-size: 24px; vertical-align: middle;">&rarr;</span>
      <span style="font-size: 18px; font-weight: 700; color: {{#if brand.primary_color}}{{brand.primary_color}}{{else}}#0D47A1{{/if}};">{{newStatus}}</span>
    </mj-text>
  </mj-column>
</mj-section>

<!-- Action Buttons -->
<mj-section background-color="#FFFFFF" padding="15px 20px">
  <mj-column width="100%">
    <mj-button href="{{ticketUrl}}">
      {{t.common.view_ticket}}
    </mj-button>
  </mj-column>
</mj-section>
